e, check=True, timeout=10).stdout)[0]\n        assert state['Id'] == cid and state['Name'] == '/' + name\n        assert state['Config']['Labels']['nhms.retirement.issue'] == '1895'\n        subprocess.run(['docker', 'rm', '-f', cid], capture_output=True, text=True, check=True, timeout=30)\n        print('OWNED_DISPOSABLE_CLUSTER_REMOVED', flush=True)\n"
