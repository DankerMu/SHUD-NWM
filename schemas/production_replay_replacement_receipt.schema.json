{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NHMS Production Replay Replacement Receipt",
  "description": "One row per (model, source, cycle) of a controlled six-basin production replay: the pre-overwrite evidence of the replaced run, the unconditional input checksums it consumed, and the post-replay evidence of its replacement (#1164 change 2, design D5). Prior state fields are sourced from the state-scope reset receipt's removed entries, never read back from the already-cleared index.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "pass_id",
    "executed",
    "source_id",
    "model_ids",
    "started_at",
    "finished_at",
    "reset_receipt",
    "inventory_census",
    "cycles",
    "rows",
    "interruption"
  ],
  "properties": {
    "schema_version": { "const": "nhms.production_replay_replacement.v1" },
    "outcome": { "type": "string", "enum": ["in_progress", "completed", "halted"] },
    "pass_id": { "type": "string", "minLength": 1 },
    "executed": { "type": "boolean" },
    "source_id": { "type": "string", "minLength": 1 },
    "model_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "reset_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "removed_entry_count"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "removed_entry_count": { "type": "integer", "minimum": 1 }
      }
    },
    "resume_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "description": "Present only on a resumed run (--resume-from): the receipt this pass carried its rows and priors from. Makes a multi-hop resume chain auditable (#1164 change 2, design D5 v6).",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "inventory_census": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_index",
        "runs_root",
        "enumeration_status",
        "enumeration_detail",
        "scopes",
        "frontier_cycle",
        "requested_frontier_cycle"
      ],
      "description": "Start-time on-site census; never a frozen survey count. The run enumeration walks the whole runs/ directory (no window truncation) so frontier_cycle is what is on disk, with the requested range recorded beside it.",
      "properties": {
        "state_index": { "type": "string", "minLength": 1 },
        "runs_root": { "type": "string", "minLength": 1 },
        "enumeration_status": { "type": "string", "enum": ["present", "absent", "undeterminable"] },
        "enumeration_detail": { "type": ["string", "null"] },
        "frontier_cycle": { "type": ["string", "null"], "pattern": "^[0-9]{10}$" },
        "requested_frontier_cycle": { "type": ["string", "null"], "pattern": "^[0-9]{10}$" },
        "scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_id", "source_id", "run_cycle_count", "run_cycles", "state_index_entry_count"],
            "properties": {
              "model_id": { "type": "string", "minLength": 1 },
              "source_id": { "type": "string", "minLength": 1 },
              "run_cycle_count": { "type": "integer", "minimum": 0 },
              "run_cycles": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{10}$" } },
              "state_index_entry_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "cycles": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{10}$" } },
    "rows": { "type": "array", "items": { "$ref": "#/definitions/row" } },
    "interruption": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cycle", "reason", "detail", "recorded_at"],
          "properties": {
            "cycle": { "type": "string", "pattern": "^[0-9]{10}$" },
            "reason": {
              "type": "string",
              "enum": [
                "forcing_source_absent",
                "forcing_staging_unverified",
                "submission_failed",
                "convergence_timeout",
                "state_index_undeterminable",
                "first_cycle_bootstrap_assertion_failed",
                "key_consistency_drift"
              ]
            },
            "detail": {},
            "recorded_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    }
  },
  "definitions": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path", "status", "file_count", "total_bytes", "sha256", "files", "detail"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["present", "absent", "undeterminable"] },
        "file_count": { "type": ["integer", "null"], "minimum": 0 },
        "total_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "files": {
          "type": ["array", "null"],
          "description": "Sorted relative file names; recorded for run output inventories, whose byte content legitimately changes across a replay while the file set must not.",
          "items": { "type": "string" }
        },
        "detail": { "type": ["string", "null"] }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle",
        "cycle_time",
        "source_id",
        "model_id",
        "run_id",
        "status",
        "prior",
        "inputs",
        "staging",
        "submission",
        "convergence",
        "new",
        "key_consistency",
        "bootstrap_assertion"
      ],
      "properties": {
        "cycle": { "type": "string", "pattern": "^[0-9]{10}$" },
        "cycle_time": { "type": "string", "format": "date-time" },
        "source_id": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["planned", "completed", "halted", "verified_skip"] },
        "prior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_manifest_sha256",
            "output_inventory",
            "no_prior_run",
            "state",
            "state_source",
            "prior_source",
            "river_network_version_id",
            "output_segment_count",
            "terminal_job_ids"
          ],
          "properties": {
            "prior_source": {
              "type": "string",
              "enum": ["captured", "resumed_receipt"],
              "description": "Provenance of this pre-image half. 'resumed_receipt' means the row was recovered from the receipt this run resumes from, because the run tree it describes has already been overwritten by the interrupted attempt (round-2 B2-1); re-capturing it would record a replay as its own pre-image."
            },
            "run_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "output_inventory": { "$ref": "#/definitions/digest" },
            "no_prior_run": { "type": "boolean" },
            "state": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["state_id", "checksum", "created_at", "source"],
                  "properties": {
                    "state_id": { "type": ["string", "null"] },
                    "checksum": { "type": ["string", "null"] },
                    "created_at": { "type": ["string", "null"] },
                    "source": { "const": "reset_receipt" }
                  }
                }
              ]
            },
            "state_source": { "const": "reset_receipt" },
            "river_network_version_id": { "type": ["string", "null"] },
            "output_segment_count": { "type": ["integer", "null"], "minimum": 0 },
            "terminal_job_ids": {
              "type": "array",
              "description": "Pre-pass baseline of the journal's terminal completion job ids: the original run's records survive the state-scope reset, so completion is 'a NEW id appeared', not 'an id exists'.",
              "items": { "type": "string" }
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forcing_package", "model_package"],
          "description": "Recorded unconditionally on every row, including rows with no prior run.",
          "properties": {
            "forcing_package": { "$ref": "#/definitions/digest" },
            "model_package": { "$ref": "#/definitions/digest" }
          }
        },
        "staging": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "copied_files", "verified", "detail"],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "source_absent",
                    "same_root",
                    "already_staged",
                    "stage_planned",
                    "staged",
                    "stage_failed",
                    "verify_failed"
                  ]
                },
                "copied_files": { "type": "integer", "minimum": 0 },
                "verified": { "type": "boolean" },
                "repair_cycle_exemption": {
                  "type": "boolean",
                  "description": "Set only when an absent forcing source is tolerated because the cycle runs through the repair parameter set (GFS 2026070712)."
                },
                "detail": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "submission": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["returncode", "repair_parameter_set", "submitted_at"],
              "properties": {
                "returncode": { "type": "integer" },
                "repair_parameter_set": { "type": "boolean" },
                "submitted_at": { "type": "string", "format": "date-time" }
              }
            }
          ]
        },
        "convergence": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "journal_terminal",
                "prior_terminal_job_ids",
                "new_terminal_job_ids",
                "state_entry_present",
                "state_index_status",
                "waited_seconds"
              ],
              "properties": {
                "journal_terminal": {
                  "type": "boolean",
                  "description": "True only when a terminal completion job id appeared that was absent from the pre-pass baseline."
                },
                "terminal_evidence": {
                  "type": ["string", "null"],
                  "enum": ["new_job", "prior_pass", null],
                  "description": "How the terminal leg was satisfied: new_job = a completion job id absent from the pre-pass baseline; prior_pass = a currently replaced successor checksum on a prior-eligible model, i.e. one the resume receipt shows an earlier pass already replayed (the scheduler refuses to resubmit such a model, so no new id can appear); null = unsatisfied. Absent on rows carried over from a receipt written before this field existed."
                },
                "prior_eligible": {
                  "type": "boolean",
                  "description": "True when the receipt this pass resumed from carries a row for this (cycle, model) whose prior pass durably observed BOTH the replaced successor (convergence.state_entry_present true) AND terminal attribution (that row's terminal_evidence, or journal_terminal on rows predating it) — or a completed/verified_skip status — and the journal carries a terminal job id for the cycle. Derived from the resume receipt alone, never from the live index, so nothing this pass observes can widen it: with no --resume-from it is false for every row and only a new terminal job id can converge the cycle. Eligibility is necessary but not sufficient: acceptance also requires the live successor to still carry the checksum that row recorded. Absent on rows carried over from a receipt written before this field existed."
                },
                "successor_checksum": {
                  "type": ["string", "null"],
                  "description": "The successor state entry's checksum as observed at the deciding poll, or null when the model had no replaced successor then. Binds this row's prior evidence to the exact successor it describes: a later resume accepts prior_pass only while the index still holds this checksum, since a different one means something re-published that successor after this observation. Absent on rows carried over from a receipt written before this field existed, which skip the check."
                },
                "prior_terminal_job_ids": { "type": "array", "items": { "type": "string" } },
                "new_terminal_job_ids": { "type": "array", "items": { "type": "string" } },
                "state_entry_present": {
                  "type": "boolean",
                  "description": "True only when the successor entry's checksum differs from the reset receipt's removed entry."
                },
                "state_index_status": { "type": "string", "enum": ["present", "absent", "undeterminable"] },
                "waited_seconds": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "new": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "run_manifest_sha256",
                "output_inventory",
                "state_id",
                "state_checksum",
                "init_mode",
                "quality",
                "packaged_ic_checksum",
                "river_network_version_id",
                "output_segment_count"
              ],
              "properties": {
                "run_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
                "output_inventory": { "$ref": "#/definitions/digest" },
                "state_id": { "type": ["string", "null"] },
                "state_checksum": { "type": ["string", "null"] },
                "init_mode": { "type": ["integer", "null"] },
                "quality": { "type": ["string", "null"] },
                "packaged_ic_checksum": { "type": ["string", "null"] },
                "river_network_version_id": { "type": ["string", "null"] },
                "output_segment_count": { "type": ["integer", "null"], "minimum": 0 }
              }
            }
          ]
        },
        "key_consistency": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": true,
              "required": ["status", "detail"],
              "properties": {
                "status": { "type": "string", "enum": ["consistent", "drift", "undeterminable"] },
                "detail": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "bootstrap_assertion": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status", "detail"],
              "properties": {
                "required": { "type": "boolean" },
                "status": { "type": "string", "enum": ["satisfied", "violated", "not_required"] },
                "detail": { "type": ["string", "null"] }
              }
            }
          ]
        }
      }
    }
  }
}
