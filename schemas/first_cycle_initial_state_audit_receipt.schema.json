{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NHMS First-Cycle Initial-State Audit Receipt",
  "description": "Read-only reconciliation of packaged calibrated-IC qualification against the earliest business run's initial-state evidence, per registered model x forecast source (#1164).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_at", "outcome", "inputs", "limits", "totals", "rows"],
      "properties": {
        "schema_version": { "const": "nhms.first_cycle_initial_state_audit.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "outcome": { "const": "completed" },
        "inputs": { "$ref": "#/definitions/inputs" },
        "limits": { "$ref": "#/definitions/limits" },
        "totals": { "$ref": "#/definitions/totals" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/definitions/row" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_at", "outcome", "refusal_reason"],
      "properties": {
        "schema_version": { "const": "nhms.first_cycle_initial_state_audit.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "outcome": { "const": "blocked" },
        "refusal_reason": {
          "type": "string",
          "enum": ["CONFIG_INVALID", "REGISTRY_UNREADABLE", "RESOURCE_BOUND_EXCEEDED", "RECEIPT_INVALID"]
        },
        "detail": { "type": "string", "maxLength": 512 }
      }
    }
  ],
  "definitions": {
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_manifest", "object_store_prefix", "sources", "registered_model_count"],
      "properties": {
        "registry_manifest": { "type": "string", "minLength": 1 },
        "object_store_prefix": { "type": "string" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "registered_model_count": { "type": "integer", "minimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_objects_rehashed", "run_evidence_lanes", "note"],
      "properties": {
        "package_objects_rehashed": { "const": false },
        "run_evidence_lanes": {
          "type": "array",
          "items": { "type": "string", "enum": ["workspace_runs", "object_store_runs"] }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "consumed_package_ic",
        "cold_start_with_qualified_ic",
        "cold_start_no_ic",
        "undetermined"
      ],
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "consumed_package_ic": { "type": "integer", "minimum": 0 },
        "cold_start_with_qualified_ic": { "type": "integer", "minimum": 0 },
        "cold_start_no_ic": { "type": "integer", "minimum": 0 },
        "undetermined": { "type": "integer", "minimum": 0 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "source",
        "ic_qualified",
        "ic_status",
        "ic_sha256",
        "ic_relative_path",
        "first_cycle",
        "first_run_id",
        "first_run_quality",
        "first_run_init_mode",
        "first_run_evidence_lane",
        "verdict"
      ],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "ic_qualified": { "type": ["boolean", "null"] },
        "ic_status": { "type": "string", "enum": ["qualified", "unqualified", "unreadable", "absent"] },
        "ic_sha256": { "type": ["string", "null"] },
        "ic_relative_path": { "type": ["string", "null"] },
        "first_cycle": { "type": ["string", "null"] },
        "first_run_id": { "type": ["string", "null"] },
        "first_run_quality": { "type": ["string", "null"] },
        "first_run_init_mode": { "type": ["integer", "null"] },
        "first_run_evidence_lane": {
          "type": ["string", "null"],
          "enum": ["workspace_runs", "object_store_runs", null]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "consumed_package_ic",
            "cold_start_with_qualified_ic",
            "cold_start_no_ic",
            "undetermined"
          ]
        },
        "detail": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
