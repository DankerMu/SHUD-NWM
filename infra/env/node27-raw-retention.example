# Node-27 raw source-data retention.
#
# Copy to /home/nwm/NWM/infra/env/node27-raw-retention.env on node-27, set mode
# 0600, and install infra/systemd/nhms-node27-raw-retention.{service,timer} as
# user units for nwm. The canonical lane runs in a separate SYSTEM unit
# generated from THIS file (see NODE27_RAW_RETENTION_LANES below); rerun
# `sudo /home/nwm/NWM/scripts/node27_canonical_retention_install.sh` after
# every change here.

NODE27_RAW_RETENTION_REPO=/home/nwm/NWM
# Read-only DSN for the display business-time watermark (this runner's ONLY
# database touch).
# #1714: the raw-retention runner ships a default application_name
# `nhms-raw-retention` (libpq fallback_application_name) so pg_stat_activity can
# attribute that read. To override, append ?application_name=<name> to the DSN
# below; an explicit value always wins.
NODE27_DISPLAY_WATERMARK_DATABASE_URL=postgresql://nhms_display_ro:REPLACE_ME@127.0.0.1:55432/nhms
NODE27_RAW_RETENTION_OBJECT_STORE_ROOT=/home/ghdc/nwm/object-store
NODE27_RAW_RETENTION_LOG_ROOT=/home/nwm/node27-raw-retention-logs
NODE27_RAW_RETENTION_LOCK_PATH=/tmp/node27-raw-retention.lock
NODE27_RAW_RETENTION_SOURCES=GFS,IFS
# Relative to the latest displayable forecast cycle, not the host clock.
#
# FLOOR (issue #2011): this value MUST be >= the display API's
# `NATIONAL_DISCHARGE_CYCLE_LOOKBACK_DAYS` + 1 -- 12 + 1 = 13 today
# (`services/tiles/mvt.py`). The copyback spec requires
# `oldest_listed_cycle - 24h >= display_watermark - retention_days`, which with
# lookback `L` and retention `R` reduces to `L <= R - 1`. Set it below the floor
# and the failure is silent on BOTH sides: `GET /api/v1/layers/discharge/cycles`
# keeps listing cycles back to `now() - L` while this run has already pruned
# their canonical mirror, so the timeline advertises cycles whose precipitation
# index answers HTTP 404 `PRECIP_CYCLE_NOT_MIRRORED` -- and the retention
# summary reports those deletions as ordinary successes, so nothing here alarms.
# The spec's remedy is to RAISE this value, never to lower the lookback. The
# inequality is enforced by the node-27 deployment receipt (copyback task 4.6 /
# #2016), not by a check in the script.
NODE27_RAW_RETENTION_DAYS=14

# Display-side rendered-PNG cache root (issue #2011). Retention prunes
# <root>/precip/<storage_source>/<cycle_token> on the SAME cutoff as
# canonical/<storage_source>/<cycle_token>, so a cycle whose mirror is gone
# cannot keep being served from cached PNGs. Nothing else under this root is
# touched -- the MVT tile cache is a sibling directory here.
# That sibling has its OWN retention runner, issue #2032:
# scripts/node27_mvt_cache_retention.py (unit
# nhms-node27-mvt-cache-retention.timer, env template
# infra/env/node27-mvt-cache-retention.example) prunes
# <root>/<hh>/<sha256>.pbf, <root>/<hh>/.<sha256>.pbf.<pid>.tmp and
# <root>/.locks/<hh>/<sha256>.lock on a WALL-CLOCK cutoff. The two runners
# share this env value and nothing else, and neither ever enumerates the
# other's subtree.
#
# ROOT-EQUALITY PRECONDITION (this is the first place retention's env is coupled
# to the display API's env; the guarantee only holds while both point at ONE
# tree):
#   NODE27_RAW_RETENTION_OBJECT_STORE_ROOT  ==  the display API's
#       NHMS_PRECIP_MIRROR_ROOT   (both hold the same canonical/ tree)
#   NHMS_MVT_FILE_CACHE_DIR                 ==  the value the display API
#       PROCESS actually has
# Measured on node-27 (2026-09-06): object store root /home/ghdc/nwm/object-store;
# display cache /home/nwm/.cache/nhms/mvt -- that is the ExecStart default in
# nhms-display-api.service, NOT infra/env/display.example's /tmp/nhms-mvt-cache,
# so copy the running process's value, never the template's.
# Leaving it unset is safe but degrades: the cache lane records
# `precip_cache_root_unconfigured` and raw + canonical are still pruned.
NHMS_MVT_FILE_CACHE_DIR=/home/nwm/.cache/nhms/mvt

# Lane selection (#2360). Comma-separated subset of `raw`, `canonical`,
# `precip-cache` (exact lowercase names, no spaces).
# Unset = all three lanes, exactly the pre-#2360 run. A value that is empty
# after trimming, or names anything else, is a preflight blocker
# (`{"field": "lanes"}`, rc=2) and NOTHING is deleted. A lane left out is one
# `{"key": <lane>, "reason": "lane_not_selected"}` entry in `skipped[]`; its
# root is never probed or listed and no copyback lock is taken for it. Every
# summary carries the selected lanes as a sorted `lanes` list.
# node-27 splits the lanes across two units, both on the 03:35 UTC tick and the
# same cutoff rule (same watermark, same NODE27_RAW_RETENTION_DAYS):
#   - this nwm USER unit nhms-node27-raw-retention.service: `raw,precip-cache`
#     (the line below). The PNG cache root is nwm-owned, so these two stay here.
#   - SYSTEM unit nhms-node27-canonical-retention.service, User=frd_muziyao (the
#     copyback root's owner): `canonical`. Its env
#     /etc/nhms/node27-canonical-retention.env is GENERATED from this file by
#     scripts/node27_canonical_retention_install.sh, which drops this file's
#     LANES / LOG_ROOT / LOCK_PATH / LOG_FILE / SUMMARY_PATH / BOOTSTRAP_LOG
#     lines and appends LANES=canonical, LOG_ROOT=/var/log/nhms-node27-canonical-retention
#     and LOCK_PATH=/run/nhms-node27-canonical-retention/raw-retention.lock. It is
#     a snapshot: rerun the installer after every edit of this file.
NODE27_RAW_RETENTION_LANES=raw,precip-cache

# HOW TO READ THIS UNIT (issue #2011; node-27 observations 2026-09-06, local
# reproductions marked as such; the canonical lane's permission model is #2100;
# the canonical lane's copyback lock is #2252).
#
# CANONICAL LANE UNDER THE COPYBACK MUTEX (#2252, owner decision 2026-09-14;
# identity split #2360, 2026-09-18).
# On node-27 NODE27_RAW_RETENTION_OBJECT_STORE_ROOT is the shared copyback root
# node-22 writers promote canonical/ trees into, so every canonical/<S>/<cycle>
# removal holds `<root>/.nhms-copyback-batch.lock` (POSIX record lock, one
# acquisition per tree, 300 s pass-level wait budget). raw/ and the precip
# cache are never locked. That lock file is `0600` and owned by the copyback
# root's owner (frd_muziyao, uid 1103), and the lock identity contract is
# deliberately not relaxed. The canonical lane therefore runs as that owner in
# the system unit nhms-node27-canonical-retention.service
# (NODE27_RAW_RETENTION_LANES=canonical), and this nwm (uid 1005) unit does not
# select it -- it records `canonical` / `lane_not_selected` and never opens the
# lock. Before that split (#2360) this unit selected all three lanes and every
# aged canonical cycle ended in `failed[]` with `lock_failure: "lock_unsafe"`,
# rc=1 on every such tick. Seeing `lock_unsafe` again now means the lane is run
# by the wrong account (a LANES line lost here, or the system unit's User=
# changed) -- an incident, not the steady state.
# `lock_failure` meanings: `lock_timeout` -- another process held the mutex past
# the remaining wait budget; `lock_budget_exhausted` -- the pass budget was
# already spent, no attempt was made; `lock_unsafe` -- the lock file is unsafe,
# unopenable (the uid state above) or the configuration was refused. None of
# them is fixed by deleting the lock file: that splits the mutex.
#
# Steady state since #2100 (and, for canonical, since #2360 runs that lane as
# the copyback root's owner): every canonical mirror directory the runner has to
# remove (`<cycle>/` and its `prcp_rate_or_amount/`) or unlink from (their
# parent `canonical/<S>/`, which needs `w+x` for the `rmdir` and is never
# removed itself) is `2775` with group `nwmuser` (gid 1107), which `nwm` is a
# member of. The mirror
# producers write that mode on every directory they own and the owner-side sweep
# in docs/runbooks/current-production-ops.md 5.3 covers the rest, so aged
# canonical cycles are actually deleted, `failed[]` is EMPTY, the runner returns
# rc=0 (`return 1 if payload["counts"]["failed"] else 0`), the wrapper propagates
# that rc unchanged (`RC=$?` ... `exit "$RC"`), and this `Type=oneshot` unit does
# NOT sit in `systemctl --user --failed`.
#   - A `PermissionError` in `failed[]` is an INCIDENT, not the expected shape.
#     On the canonical lane it means one of two things: the producer mode
#     regressed, or that storage source was added to
#     NODE27_RAW_RETENTION_SOURCES without the per-source sweep that 5.3
#     requires (`canonical/` itself is deliberately left `755` with a group
#     `nwm` is not in, so an unswept source fails closed). Fail-closed is the
#     whole point: the first `unlink` is denied and ZERO bytes are removed, so
#     the remedy is the sweep -- or a producer fix -- and never a manual delete.
#   - The historical ops criterion `counts.failed == 0`
#     (docs/runbooks/receipts/2026-06-27-node27-raw-retention-live-proof.md) was
#     restored by #2100 after being suspended while the canonical tree was
#     `755 frd_muziyao nfsdata`, suspended again while the canonical lane ran as
#     nwm (`lock_unsafe`, #2252), and is restored by the #2360 split: it holds
#     for BOTH units' summaries.
#   - Both units alert on `Result=failed` (#2360): this user unit through
#     `OnFailure=nhms-node27-unit-failure-alert@%n.service` (user journal), the
#     canonical system unit through
#     `OnFailure=nhms-node27-system-unit-failure-alert@%n.service`, which runs
#     the same handler as nwm with NHMS_UNIT_FAILURE_JOURNAL_SCOPE=system. rc=1
#     (any `failed[]` entry) and rc=2 (preflight blocked) reach the operator;
#     the states below exit 0 and never reach `OnFailure=`.
#   - `failed[]` alone is still NOT the whole signal. It stays empty in two
#     states where retention has silently stopped:
#       * Lanes retired silently. If `<object-store>` itself loses `x`,
#         `config_from_env`'s `resolve(strict=True)` still succeeds (it stats
#         that root from its PARENT), so the loud `preflight_blocked` rc=2 path
#         is NOT taken; `_resolve_lane_root` records a `<lane>_root_unsafe` /
#         `path_unavailable` entry in `skipped[]` for BOTH lanes under it (raw
#         and canonical), `failed[]` stays empty, `main()` returns 0, and the
#         cache lane keeps pruning, so `counts.deleted` and `freed_bytes` still
#         look healthy. Reproduced locally on 3.11 by dropping `x` on the object
#         store: rc=0, counts {'deleted': 1, 'failed': 0, 'skipped': 2} -- there
#         a predicate's lstat raises and `_resolve_lane_root`'s `except OSError`
#         builds the entry. An ESTALE on a lane root lands in the SAME entry
#         shape by whichever of the two routes sees the stale handle first: a
#         raising predicate takes that `except OSError`, while an ESTALE out of
#         `resolve()` is caught inside `_safe_resolved_dir`, returned as a
#         `path_unavailable` blocker and forwarded -- `error`/`error_type`
#         included -- by `_resolve_lane_root`'s `resolved is None` branch. An
#         ESTALE on `<object-store>` itself is a preflight blocker instead.
#       * A stale receipt. If the run raises before writing its summary no new
#         file appears, so `ls -t ... | head -1` returns the PREVIOUS tick's
#         healthy file. #2104 closed the crash path on the lane/source probes --
#         an unwrapped probe on a lane root or a source root, which used to
#         retire all three lanes and skip `_write_summary` entirely -- and
#         #2309 closed the one below them: an `OSError` (ESTALE, EIO) while
#         `_dir_size` walks a deletion target now retires THAT target only, as
#         a `<lane>_target_unsafe` / `path_unavailable` skip carrying
#         `error`/`error_type` (never planned, never deleted), and the tick
#         still writes its summary. That skip ends in `_unsafe`, so the check
#         below goes RED on it. No other crash path is known, but none is
#         ruled out either: a tick that dies before `_write_summary` for any
#         other reason is caught only by the freshness clause below.
#     Check freshness, execution mode and every failure together, on the
#     newest summary of EACH unit (nwm user unit, then the canonical system
#     unit, whose LogsDirectory is 0755 so nwm can read it):
#       red=0; for d in /home/nwm/node27-raw-retention-logs /var/log/nhms-node27-canonical-retention; do
#       jq -e '
#         (.execution_mode == "production_execute")
#         and ((.finished_at | fromdateiso8601) > (now - 26*3600))
#         and ([.failed[]]                                          | length == 0)
#         and ([.skipped[] | select(.reason | endswith("_unsafe"))] | length == 0)
#       ' "$(ls -t "$d"/raw-retention-*.json | head -1)" || { echo "RED: $d"; red=1; }; done; [ "$red" = 0 ]
#     The whole command exits 1 when either directory is RED.
#     A canonical `*_unsafe` skip or a stale canonical summary exits 0 at the
#     unit level and never reaches `OnFailure=`; only this check (on the
#     second directory) sees them. `lane_not_selected` does not end in
#     `_unsafe`, so the split itself keeps both checks green.
#     26h is not a magic constant: it is the 24h tick of
#     nhms-node27-raw-retention.timer (`OnCalendar=*-*-* 03:35:00 UTC`, daily)
#     plus slack. Exit codes over the summary shapes below -- all of them
#     produced by driving the shipped script, except the stale one, which is a
#     real summary with only `finished_at` aged past the window. Three of them --
#     the healthy tick, the `*_source_unsafe` skip and the canonical
#     `PermissionError` -- are driven by
#     `tests/test_node27_raw_retention.py::test_documented_operator_check_goes_red_on_an_unsafe_skip`,
#     which extracts and runs THIS `jq` program rather than a copy of it:
#       0  expected steady state -- fresh file, `production_execute`, `failed[]`
#          empty, no `*_unsafe` skip at either depth.
#       1  ANY entry in `failed[]`, `PermissionError` included -- clause 3 stopped
#          whitelisting that error type with #2100. Read the entry's `key`,
#          `error_type` and `error`: `PermissionError` under `canonical/` means
#          the mirror's mode/group regressed or that source was never swept
#          (5.3); a genuine IO failure reads e.g. `error_type: "OSError"` /
#          `[Errno 30] Read-only file system`.
#       1  a lane silently retired via `*_root_unsafe`, or one source inside a
#          live lane via `*_source_unsafe` -- clause 4 matches every reason
#          ending in `_unsafe`, at both depths.
#       1  a stale receipt, i.e. no new summary since the last tick.
#       1  `NODE27_RAW_RETENTION_ENABLED=false`, i.e. `execution_mode:
#          "disabled"`.
#       1  `NODE27_RAW_RETENTION_PLAN_ONLY=true`, i.e. `execution_mode:
#          "plan_only"` -- it also reports `status: "completed"`, which is why
#          the first clause reads `execution_mode` and not `status`.
#          Both rollback gates are intended failures, not false alarms: this
#          check answers "is retention actually pruning right now", and neither
#          a unit an operator switched off nor one that only lists targets is.
#       1  `preflight_blocked` -- nothing ran; the runner already exits rc=2
#          there.
#     Exit 0 means those four clauses and nothing more: fresh summary,
#     `production_execute`, an EMPTY `failed[]` (on ANY lane -- the clause does
#     not single out canonical), and no `*_unsafe` skip of either depth (no
#     `*_root_unsafe` lane root, no `*_source_unsafe` source root). It does NOT
#     mean all three lanes ran: a lane that retired
#     itself with `<lane>_root_missing` or `precip_cache_root_unconfigured`
#     passes clause 4 deliberately, because `_resolve_lane_root` treats absence
#     as a benign per-lane skip and matching it would hold a fresh install at
#     exit 1 until every lane root exists. Reproduced locally: canonical tree
#     and `<cache>/precip` both absent -> counts {'deleted': 1, 'failed': 0},
#     criterion still exits 0.
#     Lane liveness lives in `skipped[]`, so read it on every tick --
#     `jq '.skipped[] | select(.key | contains("/") | not)' <summary>` lists the
#     entries keyed by a bare lane name, while
#     `jq '.skipped[] | select(.reason | endswith("_source_unsafe"))' <summary>`
#     lists the per-source ones (#2104). Read BOTH: a retired lane root does not
#     always produce a lane-level entry. Every probe in the lane-root gate stats
#     the lane root FROM ITS PARENT and never exercises that root's own `x`, and
#     the canonical and precip-cache lanes then walk the CONFIGURED sources
#     instead of listing their root -- so one of those two lane roots losing `x`
#     surfaces (on the pinned 3.11 interpreter) as one `<prefix>_source_unsafe`
#     entry per configured source and NO lane-level entry at all; that is what
#     the `canonical/` 0o000 reproduction writes. The raw lane does list its own
#     root, so there the same mode change reads `raw_root_unsafe` instead.
#     Reading them: one `*_source_unsafe` entry names that one source root
#     (e.g. `canonical/IFS` alone); a full set covering every configured source
#     of one mapped lane means check that LANE root's own mode first, because a
#     mapped lane root that lost `x` can only appear this way.
#     The same `_root_missing` reason means
#     opposite things per lane: `precip_cache_root_missing` is expected until
#     the display API caches its first PNG (`<cache>/precip` is created lazily
#     on write, services/precip/cache.py), whereas `canonical_root_missing` on
#     node-27 means the mirror tree is gone.
#     Reading an `*_unsafe` entry (#2104 item 3, delivered): the entries whose
#     `detail` is `path_unavailable` -- and only those -- carry `error` (the
#     `OSError` text, path included) and `error_type` (the exception class name
#     -- `PermissionError` for EACCES, plain `OSError` for ESTALE) beside `key`,
#     `reason`, `path` and `detail`, so that errno no longer has to be probed by
#     hand. An `*_root_unsafe` entry with any other detail (`path_is_symlink`,
#     `path_not_directory`) carries neither field: the SHAPE of the root
#     disqualified it, no syscall raised, so there is no errno to report. The
#     errno outlives the per-tick JSON: the runner prints the whole summary
#     payload to stdout and the wrapper appends runner stdout+stderr to
#     `$NODE27_RAW_RETENTION_LOG_FILE` (default `<log root>/raw-retention.log`),
#     so that append-only log still holds the payload -- errno included -- after
#     the summary files rotate. The errno is never written as a line of its
#     own -- it reaches that log only inside the payload.

# Rollout/rollback gates (issue #1407). Both default to today's execute-only
# behaviour, so leaving them unset changes nothing:
#   NODE27_RAW_RETENTION_ENABLED   (default true)  false => summary status
#       "disabled", zero deletions.
#   NODE27_RAW_RETENTION_PLAN_ONLY (default false) true  => targets are still
#       collected and reported, no tree is removed.
# These supersede the env half of the execute-only decision (commit 9c1625ee,
# "no longer expose NODE27_RAW_RETENTION_DRY_RUN") rather than break it: the
# --dry-run/--execute CLI flags stay removed and the defaults keep production
# deleting. The plan-only gate deliberately does NOT reuse the old
# NODE27_RAW_RETENTION_DRY_RUN name, because that variable defaulted to true --
# a leftover `NODE27_RAW_RETENTION_DRY_RUN=true` line in a live config would
# silently return production to zero deletions, exactly the failure 9c1625ee
# removed. Under the new name any leftover line is inert.
# NODE27_RAW_RETENTION_ENABLED=true
# NODE27_RAW_RETENTION_PLAN_ONLY=false
