# Node-27 raw source-data retention.
#
# Copy to /home/nwm/NWM/infra/env/node27-raw-retention.env on node-27, set mode
# 0600, and install infra/systemd/nhms-node27-raw-retention.{service,timer} as
# user units for nwm.

NODE27_RAW_RETENTION_REPO=/home/nwm/NWM
# Read-only DSN for the display business-time watermark (this runner's ONLY
# database touch).
# #1714: the raw-retention runner ships a default application_name
# `nhms-raw-retention` (libpq fallback_application_name) so pg_stat_activity can
# attribute that read. To override, append ?application_name=<name> to the DSN
# below; an explicit value always wins.
NODE27_DISPLAY_WATERMARK_DATABASE_URL=postgresql://nhms_display_ro:REPLACE_ME@127.0.0.1:55432/nhms
NODE27_RAW_RETENTION_OBJECT_STORE_ROOT=/home/ghdc/nwm/object-store
NODE27_RAW_RETENTION_LOG_ROOT=/home/nwm/node27-raw-retention-logs
NODE27_RAW_RETENTION_LOCK_PATH=/tmp/node27-raw-retention.lock
NODE27_RAW_RETENTION_SOURCES=GFS,IFS
# Relative to the latest displayable forecast cycle, not the host clock.
#
# FLOOR (issue #2011): this value MUST be >= the display API's
# `NATIONAL_DISCHARGE_CYCLE_LOOKBACK_DAYS` + 1 -- 12 + 1 = 13 today
# (`services/tiles/mvt.py`). The copyback spec requires
# `oldest_listed_cycle - 24h >= display_watermark - retention_days`, which with
# lookback `L` and retention `R` reduces to `L <= R - 1`. Set it below the floor
# and the failure is silent on BOTH sides: `GET /api/v1/layers/discharge/cycles`
# keeps listing cycles back to `now() - L` while this run has already pruned
# their canonical mirror, so the timeline advertises cycles whose precipitation
# index answers HTTP 404 `PRECIP_CYCLE_NOT_MIRRORED` -- and the retention
# summary reports those deletions as ordinary successes, so nothing here alarms.
# The spec's remedy is to RAISE this value, never to lower the lookback. The
# inequality is enforced by the node-27 deployment receipt (copyback task 4.6 /
# #2016), not by a check in the script.
NODE27_RAW_RETENTION_DAYS=14

# Display-side rendered-PNG cache root (issue #2011). Retention prunes
# <root>/precip/<storage_source>/<cycle_token> on the SAME cutoff as
# canonical/<storage_source>/<cycle_token>, so a cycle whose mirror is gone
# cannot keep being served from cached PNGs. Nothing else under this root is
# touched -- the MVT tile cache is a sibling directory here.
#
# ROOT-EQUALITY PRECONDITION (this is the first place retention's env is coupled
# to the display API's env; the guarantee only holds while both point at ONE
# tree):
#   NODE27_RAW_RETENTION_OBJECT_STORE_ROOT  ==  the display API's
#       NHMS_PRECIP_MIRROR_ROOT   (both hold the same canonical/ tree)
#   NHMS_MVT_FILE_CACHE_DIR                 ==  the value the display API
#       PROCESS actually has
# Measured on node-27 (2026-09-06): object store root /home/ghdc/nwm/object-store;
# display cache /home/nwm/.cache/nhms/mvt -- that is the ExecStart default in
# nhms-display-api.service, NOT infra/env/display.example's /tmp/nhms-mvt-cache,
# so copy the running process's value, never the template's.
# Leaving it unset is safe but degrades: the cache lane records
# `precip_cache_root_unconfigured` and raw + canonical are still pruned.
NHMS_MVT_FILE_CACHE_DIR=/home/nwm/.cache/nhms/mvt

# HOW TO READ THIS UNIT UNTIL #2100 LANDS (issue #2011, measured on node-27
# 2026-09-06). The canonical tree is `755 frd_muziyao nfsdata` and this runner
# is `nwm`, so every canonical target fails with `PermissionError`. That is the
# EXPECTED STEADY STATE, not an incident:
#   - `failed[]` is permanently non-empty on the canonical lane, so the runner
#     returns rc=1 on every tick (`return 1 if counts.failed else 0`), the
#     wrapper propagates it, and this `Type=oneshot` unit therefore sits
#     permanently in `systemctl --user --failed`. The unit carries no
#     `OnFailure=` (unlike nhms-node27-timeseries-retention and
#     nhms-node27-resource-governance), so nothing pages -- but the exit code
#     stops being usable as a raw-lane signal.
#   - The historical ops criterion `counts.failed == 0` (2026-06-27 receipt)
#     CANNOT hold again until #2100 is resolved. Do not re-adopt it.
#   - The real signal is a `failed[]` entry whose `error_type` is NOT
#     `PermissionError`. Check the newest summary:
#       jq -e '[.failed[] | select(.error_type != "PermissionError")] | length == 0' \
#         "$(ls -t /home/nwm/node27-raw-retention-logs/raw-retention-*.json | head -1)"
#     Exit 0 = only the known #2100 failures; exit 1 = a real IO failure, read
#     that entry's `key`/`error`. Also watch `counts.deleted` and
#     `freed_bytes`: raw and precip-cache must keep pruning normally.

# Rollout/rollback gates (issue #1407). Both default to today's execute-only
# behaviour, so leaving them unset changes nothing:
#   NODE27_RAW_RETENTION_ENABLED   (default true)  false => summary status
#       "disabled", zero deletions.
#   NODE27_RAW_RETENTION_PLAN_ONLY (default false) true  => targets are still
#       collected and reported, no tree is removed.
# These supersede the env half of the execute-only decision (commit 9c1625ee,
# "no longer expose NODE27_RAW_RETENTION_DRY_RUN") rather than break it: the
# --dry-run/--execute CLI flags stay removed and the defaults keep production
# deleting. The plan-only gate deliberately does NOT reuse the old
# NODE27_RAW_RETENTION_DRY_RUN name, because that variable defaulted to true --
# a leftover `NODE27_RAW_RETENTION_DRY_RUN=true` line in a live config would
# silently return production to zero deletions, exactly the failure 9c1625ee
# removed. Under the new name any leftover line is inert.
# NODE27_RAW_RETENTION_ENABLED=true
# NODE27_RAW_RETENTION_PLAN_ONLY=false
