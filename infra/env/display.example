# 27-side readonly display example for infra/compose.display.yml.
# Use with:
#   docker compose --env-file infra/env/display.example -f infra/compose.display.yml config

NHMS_APP_IMAGE=nhms-app
NHMS_IMAGE_TAG=m22-placeholder
NHMS_CONTAINER_UID=1000
NHMS_CONTAINER_GID=1000
NHMS_DISPLAY_API_PORT=8080
NHMS_DISPLAY_WORKERS=2
NHMS_DISPLAY_DB_POOL_SIZE=4
NHMS_DISPLAY_DB_MAX_OVERFLOW=2

NHMS_SERVICE_ROLE=display_readonly
NHMS_REQUIRE_SERVICE_ROLE=true
NHMS_AUTH_MODE=production
UV_CACHE_DIR=/tmp/nhms-uv-cache
NHMS_DISPLAY_DISABLE_CONTROL_MUTATIONS=true
NHMS_DISPLAY_ALLOW_LOCAL_FILE_LOGS=false

# #2079: shared secret that lets an out-of-process caller force a display
# catalog cache refresh (header `x-nhms-cache-warm: <token>`, compared with
# hmac.compare_digest). Its only legitimate holder is the node-27 prewarm, so
# infra/env/node27-ingest.env MUST carry the SAME value. Leaving it unset is the
# safe default: no header value forces a refresh and only the in-process warmer
# (an ASGI scope mark) can, at the cost of a <=45 s stale discovery window.
# Never leave the placeholder below in a deployed display.env, and never put the
# real value in a receipt.
# NOTE (known gap, #2079 design D5): infra/compose.display.yml enumerates its
# `environment:` keys one by one and does NOT pass this one through. The current
# deployment path is not compose -- it is `set -a; . display.env` from
# infra/systemd/nhms-display-api.service / scripts/ops/start-display-api.sh,
# which injects the whole file. A future compose deployment must add the
# passthrough AND the key to DISPLAY_AUDITED_INTERPOLATION_ENV in
# scripts/validate_two_node_docker_runtime.py, or the token will be declared
# here, never reach the app, and prewarm will silently degrade.
NHMS_DISPLAY_CACHE_WARM_TOKEN=change-me-cache-warm-token

# Enable readonly live PostGIS MVT overlays. This does not grant write/control
# capability; keep DATABASE_URL on a readonly role and keep control mutations off.
NHMS_ENABLE_LIVE_POSTGIS_MVT=true
NHMS_MVT_FILE_CACHE_DIR=/tmp/nhms-mvt-cache

# #2010: read-only mirror root for the canonical precipitation products the
# node-22 copyback writes onto the shared NFS tree. Display-side name on purpose:
# the display_readonly profile refuses to start when the compute-side
# NHMS_OBJECT_STORE_COPYBACK_ROOT is merely present (apps/api/runtime_mode.py).
# Commented out here; the real value is configured with the deployment (#2017).
# NHMS_PRECIP_MIRROR_ROOT=/home/ghdc/nwm/object-store

# Use a real readonly database role. The username here is intentionally ro-suffixed.
# #1714: the display API ships a default application_name `nhms-display-api` (libpq
# fallback_application_name) so pg_stat_activity can attribute it. To override,
# append ?application_name=<name> to the DSN below; an explicit value always wins.
DATABASE_URL=postgresql://nhms_display_ro:change-me@db.internal.example:5432/nhms

# Readonly display object-store root for disk-resident SHUD station forcing CSVs.
OBJECT_STORE_ROOT=/home/ghdc/nwm/object-store

# Host source is compose-only. 22 sees the same exported directory as
# /ghdc/data/nwm/published; 27 reads it locally from /home/ghdc/nwm/published.
NHMS_PUBLISHED_ARTIFACT_HOST_ROOT=/home/ghdc/nwm/published
NHMS_PUBLISHED_ARTIFACT_ROOT=/var/lib/nhms/published
NHMS_PUBLISHED_ARTIFACT_URI_PREFIX=published://
NHMS_PUBLISHED_ARTIFACT_S3_BUCKET=nhms-prod
NHMS_PUBLISHED_ARTIFACT_S3_PREFIX=published
NHMS_LOG_TAIL_MAX_BYTES=1048576

NHMS_ARTIFACT_BACKEND=local
# Read-only display consumer/config identity. Node-27 ingest is the producer of
# audited DB URIs; this value does not assert a separate physical store.
OBJECT_STORE_PREFIX=s3://nhms-prod
S3_ENDPOINT_URL=https://object-store.internal.example
S3_BUCKET_NAME=nhms-prod
AWS_ACCESS_KEY_ID=readonly-key-placeholder
AWS_SECRET_ACCESS_KEY=readonly-secret-placeholder

CORS_ALLOWED_ORIGINS=https://display.internal.example
