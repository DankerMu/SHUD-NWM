# Node-27 data-plane ingest example for scripts/node27_autopipe_cron.sh.
# Copy to infra/env/node27-ingest.env with mode 0600 on node-27, then replace
# placeholders with writer credentials and local paths. This file is not for the
# display API; do not source infra/env/display.env for ingest.

NHMS_NODE27_INGEST_ROLE=node27_data_plane_ingest

# Writer-capable node-27 PostgreSQL URL. Do not use the display_readonly role.
# #1714: the autopipe tick and its subprocesses ship their own default
# application_name (nhms-autopipe / nhms-ingest-run / nhms-output-parser /
# nhms-refresh-coverage, via libpq fallback_application_name) so
# pg_stat_activity can attribute them. To override, append
# ?application_name=<name> to the DSN below; an explicit value always wins.
# #1774: `nhms_ingest_rw` is a real, non-superuser role, provisioned by
# scripts/node27_provision_write_roles.sh -- not a placeholder. It owns the
# application-schema relations (both stats-guard ANALYZE legs need that) and
# cannot `COPY ... FROM PROGRAM`. Deploying the superuser `nhms` here instead is
# the silent superuser fallback this template exists to prevent.
DATABASE_URL=postgresql://nhms_ingest_rw:change-me@127.0.0.1:55432/nhms
# Positive endpoint allowlist for node-27 ingest destinations. Keep the default
# unless this host intentionally exposes the node-27 writer on a different local
# endpoint.
# NODE27_INGEST_ALLOWED_DATABASE_ENDPOINTS=127.0.0.1:55432,localhost:55432

# Node-27 local view of the shared object-store and basin geometry sources.
OBJECT_STORE_ROOT=/home/ghdc/nwm/object-store
OBJECT_STORE_PREFIX=s3://nhms
BASINS_ROOT=/home/ghdc/nwm/Basins

# Local working/log roots owned by the nwm user on node-27.
AUTOPIPE_WORK_ROOT=/home/nwm/autopipe-work
AUTOPIPE_LOG_ROOT=/home/nwm/autopipe-logs
AUTOPIPE_RUN_WORKERS=2
AUTOPIPE_COVERAGE_WORKERS=2
AUTOPIPE_MVT_PREWARM_ENABLED=1
AUTOPIPE_MVT_PREWARM_ZOOMS=3,4,5
AUTOPIPE_MVT_PREWARM_WORKERS=8
# #2079: MUST be identical to NHMS_DISPLAY_CACHE_WARM_TOKEN in
# infra/env/display.env -- it is the display process that compares the two. It is
# what makes the two prewarm discovery hops (/cycles, /valid-times) bypass the
# catalog cache right after publish. When it is missing here, prewarm sends no
# such header, prints one warning line to stderr per process, and discovery
# degrades to a <=45 s stale window that self-heals on the next tick; the tick
# does NOT fail. A value that does not match the display side degrades the same
# way but without the warning.
# Commented out on purpose: unset is the safe default, and this template gets
# installed verbatim -- an active placeholder would ship a repo-public value as
# the real token on both sides and silently re-open #2079. Generate the shared
# value with `openssl rand -hex 32`, write the SAME value into both files (0600),
# never deploy a placeholder, and never put the real value in a receipt.
# The token MUST be ASCII (`openssl rand -hex 32` is): prewarm sends it through
# http.client.putheader, which raises UnicodeEncodeError on any character outside
# latin-1 -- discovery then fails before a byte leaves the host, for every tick --
# and a non-latin-1 token can never match on the display side anyway, because
# Starlette decodes header values as latin-1. Not validated at runtime.
# NHMS_DISPLAY_CACHE_WARM_TOKEN=
AUTOPIPE_EXCLUDE_BASINS=zhaochen_hhy
OUTPUT_PARSER_BATCH_SIZE=10000
AUTOPIPE_LOG_FILE=/home/nwm/autopipe-logs/autopipe.log
AUTOPIPE_LOCK_PATH=/tmp/autopipe.cron.lock
# Per-run display coverage materialization timeout. Direct-grid basins with
# millions of river rows legitimately exceed the historical 90-second bound.
NHMS_DISPLAY_COVERAGE_REFRESH_STATEMENT_TIMEOUT_MS=900000
