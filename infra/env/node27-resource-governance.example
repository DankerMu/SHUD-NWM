# Node-27 resource governance audit.
#
# Copy to /home/nwm/NWM/infra/env/node27-resource-governance.env on node-27,
# set mode 0600, and install
# infra/systemd/nhms-node27-resource-governance.{service,timer} as user units
# for nwm.

NODE27_RESOURCE_GOVERNANCE_REPO_ROOT=/home/nwm/NWM
NODE27_GOVERNANCE_OBJECT_STORE_ROOT=/home/ghdc/nwm/object-store
NODE27_GOVERNANCE_PGDATA_ROOT=/data/GHDC/nhms-primary/pgdata
# Current host PGDATA; the container bind remains /home/postgres/pgdata/data.
# #2273 corrected source observes the configured target directly using statvfs
# available bytes (f_bavail) and device identity, never a path-prefix/home label.
# working_set_free_bytes and working_set_filesystem {path, device_identity,
# status, blockers} describe destination capacity; /home is independent telemetry.
# An unavailable/ambiguous target is WORKING_SET_FILESYSTEM_UNAVAILABLE critical,
# even for an empty working set; unavailable existing du is independently
# PGDATA_USAGE_UNAVAILABLE critical. Never fall back to /home or repeat the du scan.
# The code default /home/nwm/nhms-pgdata remains a supported explicit input for
# deployments whose live PGDATA is there; the retained old copy here is residual
# filesystem use, not a second current cluster.
# Template/source correction does not switch the pinned deployed runtime or env.
# Verify the exact deployed target and approved #2273 receipt before I8; restore
# the original env value only with the corresponding pre-write PGDATA rollback.
# No provisioning, physical migration, old-copy cleanup or production setup is
# authorized here.
NODE27_RESOURCE_GOVERNANCE_LOG_ROOT=/home/nwm/node27-resource-governance-logs

# Use a node-27-local DB account. Read-only display credentials are enough for
# the audit path; do not use this env for ingest or cleanup writes.
DATABASE_URL=postgresql://nhms_display_ro:REPLACE_ME@127.0.0.1:5432/nhms

# Same lag as the compression lane; do not invent a second lag.
NODE27_TIMESERIES_COMPRESSION_LAG_SECONDS=172800

# Archive-lane observability was removed in #1370: the archive lane is
# permanently retired (ADR 0002 Revision 2026-08-11), so the audit no longer
# reports an archive root or free-space bands, and NHMS_ARCHIVE_ROOT /
# NHMS_ARCHIVE_FREE_SPACE_{WARN,REFUSE}_BYTES are not read. A deployed env
# file that still carries them is harmless — the keys are simply ignored.
