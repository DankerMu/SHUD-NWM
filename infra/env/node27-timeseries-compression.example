# Node-27 timeseries compression runner (issue #851 / OpenSpec: tier-node27-timeseries-storage).
# Compression is DB-side only and has no archive-lane coupling (the archive lane retired in #1370, ADR 0002 Revision 2026-08-11). Do not sync this env against node27-resource-governance.env.
#
# Copy to node27-timeseries-compression.env and chmod 0600.

NODE27_TIMESERIES_COMPRESSION_REPO_ROOT=/home/nwm/NWM

# Node-27 primary Postgres (writer role — compression is DDL/DML)
# #1714: the compression runner ships a default application_name `nhms-ts-compression` (libpq
# fallback_application_name) so pg_stat_activity can attribute it. To override,
# append ?application_name=<name> to the DSN below; an explicit value always wins.
# Writer role (#1774): the DSN user MUST be `nhms_ingest_rw`, the non-superuser
# role provisioned by scripts/node27_provision_write_roles.sh. It owns every
# relation in core/hydro/met/ops/map/flood, which is what compress_chunk /
# decompress_chunk / drop_chunks / `SET TABLESPACE` / chunk ANALYZE require, and
# it cannot `COPY ... FROM PROGRAM`. Never put the superuser `nhms` here.
DATABASE_URL=postgresql://nhms_ingest_rw:REPLACE_ME_PW@127.0.0.1:55432/nhms
# The runner uses this connection read-only first to resolve the display
# business-time watermark, then applies the lag below to that watermark.

# Chunk-selection lag in seconds. 172800 = 2 days — the value node-27 has run
# since the 2026-08-07 short-lag regime (runbook section 4.3.2.1; #1237 neither
# judged nor changed the lag), now also the committed template value (#1985,
# which moved the template onto the live value). It is NOT "one
# chunk width": the narrow tables use a 1-day chunk_time_interval and the
# transitional `_legacy` siblings a 7-day one, so no single chunk width could
# describe the lag any more. The lag is a business-time delay measured from the
# display watermark, independent of chunk geometry.
# Chunks whose range_end is younger than the display-watermark cutoff are skipped.
# Governance reads the SAME variable name from its own env file
# (infra/env/node27-resource-governance.example) with the same default, and a
# unit test cross-pins the two templates.
NODE27_TIMESERIES_COMPRESSION_LAG_SECONDS=172800

# Maximum number of chunks compressed per timer tick. Not an arbitrary
# default: 4 is the capacity target decided in issue #1237 and RE-DERIVED in
# #1985 for the one-day narrow chunks, under the same DUAL constraint —
# throughput AND the whole-tick wrapper wall below.
#   throughput: one-day chunks make every canonical hypertable produce one
#     terminal chunk per day, i.e. 2 terminal chunks/day for the pair (the
#     retired figure was 2 terminal chunks/week under 7-day chunks). At one
#     tick/day, bound 4 buys 4 slots against an arrival of 2 — 2x headroom, and
#     the daily timer cadence still covers it, so no frequency change.
#   wall: 4 narrow one-day chunks at roughly 7.5 min each is about 30 min,
#     inside the 3900 s (65 min) wrapper wall.
# A transitional `_legacy` sibling is a write-frozen FINITE backlog of 7-day
# chunks with zero steady-state arrival, not an added arrival rate; its worst
# single chunk (about 508 GB, roughly 51 min at the measured 6.0 s/GB) already
# approaches the 60-minute per-chunk timeout. The expand migration's
# precondition is a compression receipt showing that backlog already drained --
# no uncompressed terminal chunk left on the table about to be renamed, which
# the daily timer reaches on its own under the 2-day lag, one single-table tick
# at a time.
# The drain cannot reach the LAST legacy chunk: its range_end is still in the
# future at rename time, so it becomes eligible at range_end + lag, days later,
# when narrow chunks are already arriving. That one chunk is compressed by an
# ATTENDED, gated compress_chunk inside the expand window (runbook section 4,
# "The surviving chunk is compressed ATTENDED"), NOT by changing this value.
# Do NOT set this to 1 for the transition: selection is a table-major PREFIX
# (ORDER BY hypertable_schema, hypertable_name, range_end; eligible[:bound]), so
# the single slot always goes to the daily hydro.river_timeseries chunk -- the
# legacy chunk and met.forcing_station_timeseries are never selected, and the
# exit condition is unreachable. Bound 1 additionally requires the section 4.5
# raised timeout/wall triple or leg 3 refuses the configuration.
# If the attended step is missed the backstop is LOUD, not silent: the tick at
# range_end + lag selects the legacy chunk plus up to three narrow ones
# ((508 + 3 x 75) GB x 6.0 s/GB + 380 s is about 4778 s, past the 3900 s wall),
# the wrapper TERMs it, no receipt is written and OnFailure mails -- daily,
# until the attended compress is done. The fix is that compress, never a bound
# change. Bound stays 4.
# It is a throughput ceiling, NOT the number of river-size chunks one tick can
# actually redeem. The per-tick hint further below (=1) governs whenever more
# than one river-size chunk could be eligible in a single tick — in that state
# the hint OVERRIDES this value. Derivation, measured inputs and the conditions
# that invalidate it (the chunk-interval and backlog conditions included):
# runbook section 4 "Per-tick capacity" invalidation list and section 4.5,
# docs/runbooks/tier-node27-timeseries-storage.md.
NODE27_TIMESERIES_COMPRESSION_PER_TICK_BOUND=4

# --- Timeout budget chain (issue #1156) -------------------------------------
# The two lane env files are one sequential assembly input. The shared preflight
# reads both as data before either runner starts; do not edit one declaration in
# isolation. Unset or empty wall/statement declarations resolve to the defaults
# below, but every explicit value must be a canonical positive decimal.
#
#   compression wrapper >= ceil(COMPRESS_TIMEOUT_MS / 1000) + 300 s cleanup
#   cold wrapper >= ceil(COLD_STATEMENT_TIMEOUT_MS / 1000) + 300 s cleanup
#   shared service wall > compression wrapper + cold wrapper + 40 s margin
#
# Defaults: compression statement 3600000 ms, wrapper 3900 s; cold statement
# 3600000 ms, wrapper 3901 s; shared service 7842 s (=3900+3901+40+1).
# The 300-second compression cleanup contract is operational: watermark,
# probes, catalog, measurements, reconcile, receipt and process cleanup all
# consume time outside compress_chunk. Raising COMPRESS_TIMEOUT_MS above
# 3600000 requires PER_TICK_BOUND=1.
#
# Per-chunk `SET statement_timeout` for compress_chunk, in milliseconds.
# Default 3600000 = 60 minutes. Minimum 1000.
#
# Sizing basis (issue #1352, measured on node-27 2026-08-10): compressing
# hydro.river_timeseries chunk _hyper_3_32_chunk (268 GB) took 1607 s, i.e.
# ~6.0 s/GB; chunk_compression_stats puts steady-state weekly chunks at
# 268-409 GB, so each needs 1600-2450 s. 3600000 ms covers 600 GB at that
# rate, ~1.5x the largest chunk observed to date. The former 840000 ms default
# predates the 17-basin dual-source régime and could not compress a single
# steady-state chunk.
NODE27_TIMESERIES_COMPRESSION_COMPRESS_TIMEOUT_MS=3600000
#
# Wall passed to `timeout --signal=TERM --kill-after=30s` by
# scripts/node27_timeseries_compression_once.sh. Default 3900.
NODE27_TIMESERIES_COMPRESSION_WRAPPER_WALL_SECONDS=3900
#
# Shared service declaration, mirrored exactly in node27-cold-residency.env.
# This is a declaration checked by the shared preflight; it does not inspect
# systemd. For catch-up, install a matching larger systemd drop-in FIRST, reload
# and verify it, then atomically set the same larger declaration in BOTH lane
# env files before starting the service. The committed unit is 7842 seconds.
NODE27_TIMESERIES_COMPRESSION_SYSTEMD_WALL_SECONDS=7842
#
# Per-tick bound during a catch-up: MANDATORY, not a hint. The invariant above
# bounds ONE chunk's budget, so a second chunk in the same tick still dies on
# the wall — whenever you raise COMPRESS_TIMEOUT_MS above the 3600000 default,
# NODE27_TIMESERIES_COMPRESSION_PER_TICK_BOUND=1 is required and leg 3 refuses
# the configuration outright if you skip it. That is also the state you are in
# wherever chunks approach the per-chunk ceiling — which the 268-409 GB
# steady-state chunks of hydro.river_timeseries do: bound 1, and let the daily
# timer drain the backlog one chunk at a time.
# Full ordered procedure (drop-in first, timer stopped+masked, no replay in the
# window, override removed FIRST on cleanup): runbook section 4.5
# "大 chunk 追赶", docs/runbooks/tier-node27-timeseries-storage.md.
# ----------------------------------------------------------------------------

# Absolute paths (must be owned by the nwm user, mode 0600 on the receipt).
NODE27_TIMESERIES_COMPRESSION_RECEIPT_PATH=/home/nwm/NWM/artifacts/receipts/node27_timeseries_compression.json
NODE27_TIMESERIES_COMPRESSION_LOCK_PATH=/tmp/nhms-node27-timeseries-compression.lock
