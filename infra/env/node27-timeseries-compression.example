# Node-27 timeseries compression runner (issue #851 / OpenSpec: tier-node27-timeseries-storage).
# Compression is DB-side only and has no archive-lane coupling (the archive lane retired in #1370, ADR 0002 Revision 2026-08-11). Do not sync this env against node27-resource-governance.env.
#
# Copy to node27-timeseries-compression.env and chmod 0600.

NODE27_TIMESERIES_COMPRESSION_REPO_ROOT=/home/nwm/NWM

# Node-27 primary Postgres (writer role — compression is DDL/DML)
# #1714: the compression runner ships a default application_name `nhms-ts-compression` (libpq
# fallback_application_name) so pg_stat_activity can attribute it. To override,
# append ?application_name=<name> to the DSN below; an explicit value always wins.
DATABASE_URL=postgresql://REPLACE_ME_WRITER:REPLACE_ME_PW@127.0.0.1:55432/nhms
# The runner uses this connection read-only first to resolve the display
# business-time watermark, then applies the 7-day lag to that watermark.

# Chunk-selection lag in seconds. Default 604800 = 7 days (one chunk width).
# Chunks whose range_end is younger than the display-watermark cutoff are skipped.
NODE27_TIMESERIES_COMPRESSION_LAG_SECONDS=604800

# Maximum number of chunks compressed per timer tick. Not an arbitrary
# default: 4 is the capacity target decided in issue #1237 and derived from
# measured node-27 inputs under a DUAL constraint — throughput (bound x 1
# tick/day vs the steady 2 terminal chunks/week) AND the whole-tick wrapper
# wall below. It is a throughput ceiling, NOT the number of river-size chunks
# one tick can actually redeem: 4 is the throughput target for the NORMAL
# one-pair week only. The per-tick hint further below (=1) governs whenever
# more than one river-size chunk could be eligible in a single tick — in that
# state the hint OVERRIDES this value. Derivation, measured inputs and the
# conditions that invalidate it (the backlog condition included): runbook
# section 4 "Per-tick capacity" invalidation list and section 4.5,
# docs/runbooks/tier-node27-timeseries-storage.md.
NODE27_TIMESERIES_COMPRESSION_PER_TICK_BOUND=4

# --- Timeout budget chain (issue #1156) -------------------------------------
# Three layers, one source of truth. Leaving a variable unset OR empty selects
# the default shown below; the wrapper's shell default (${VAR:-3900}) treats
# the empty string the same way, so both sides agree.
#
#   leg 1: ceil(COMPRESS_TIMEOUT_MS / 1000) + 60 s cleanup margin
#          <= WRAPPER_WALL_SECONDS
#   leg 2: WRAPPER_WALL_SECONDS + 40 s kill-after margin
#          <= SYSTEMD_WALL_SECONDS
#   leg 3: raising COMPRESS_TIMEOUT_MS above the 3600000 default while
#          PER_TICK_BOUND > 1 is refused outright, pre-connect. The invariant
#          bounds ONE chunk's budget, so a raised per-chunk ceiling is only
#          sound one chunk per tick (runbook section 4.5 catch-up recipe).
#
# The runner refuses to open a database connection if any of the three legs is
# violated, and the wrapper refuses to launch on a non-positive-integer wall. The
# defaults clear leg 1 with real headroom (3600 + 300 = 3900). The sequential
# compression-then-cold oneshot wall is 7842 (3900 + 3901 + 40 + 1).
#
# The "+ 60" in leg 1 is the enforced FLOOR, not a sizing recipe. A tick also
# pays for the watermark lookup, two 10 s git probes, catalog enumeration, a
# size measurement before and after the compress, and a reconcile probe on the
# error path — each a 10 s connect plus a statement capped at 60 s, i.e. up to
# ~300 s of non-compress budget under lock contention. Size the wrapper wall at
# ceil(COMPRESS_TIMEOUT_MS/1000) + 300 or more, which is what the defaults do.
#
# Per-chunk `SET statement_timeout` for compress_chunk, in milliseconds.
# Default 3600000 = 60 minutes. Minimum 1000.
#
# Sizing basis (issue #1352, measured on node-27 2026-08-10): compressing
# hydro.river_timeseries chunk _hyper_3_32_chunk (268 GB) took 1607 s, i.e.
# ~6.0 s/GB; chunk_compression_stats puts steady-state weekly chunks at
# 268-409 GB, so each needs 1600-2450 s. 3600000 ms covers 600 GB at that
# rate, ~1.5x the largest chunk observed to date. The former 840000 ms default
# predates the 17-basin dual-source régime and could not compress a single
# steady-state chunk.
NODE27_TIMESERIES_COMPRESSION_COMPRESS_TIMEOUT_MS=3600000
#
# Wall passed to `timeout --signal=TERM --kill-after=30s` by
# scripts/node27_timeseries_compression_once.sh. Default 3900.
NODE27_TIMESERIES_COMPRESSION_WRAPPER_WALL_SECONDS=3900
#
# DECLARED systemd wall. The runner cannot read the unit file, so this is a
# cross-check of what you have actually deployed, not a control. Whenever you
# change it you MUST also install the matching systemd drop-in FIRST and
# reload, otherwise a timer tick passes the Python leg-2 check and then hits
# the smaller real wall mid-DDL:
#   mkdir -p /etc/systemd/system/nhms-node27-timeseries-compression.service.d
#   printf '[Service]\nTimeoutStartSec=%s\n' "$SYSTEMD_WALL" > \
#     /etc/systemd/system/nhms-node27-timeseries-compression.service.d/override.conf
#   systemctl daemon-reload
# The committed unit ships TimeoutStartSec=7842 so one sequential compression
# then cold-residency oneshot can cover both wrapper walls plus the 40 s
# systemd margin (3900 + 3901 + 40 + 1). Keep the compression wrapper wall at 3900;
# the shared service wall is owned by the sequential lifecycle, not by
# compression alone.
NODE27_TIMESERIES_COMPRESSION_SYSTEMD_WALL_SECONDS=7842
#
# Per-tick bound during a catch-up: MANDATORY, not a hint. The invariant above
# bounds ONE chunk's budget, so a second chunk in the same tick still dies on
# the wall — whenever you raise COMPRESS_TIMEOUT_MS above the 3600000 default,
# NODE27_TIMESERIES_COMPRESSION_PER_TICK_BOUND=1 is required and leg 3 refuses
# the configuration outright if you skip it. That is also the state you are in
# wherever chunks approach the per-chunk ceiling — which the 268-409 GB
# steady-state chunks of hydro.river_timeseries do: bound 1, and let the daily
# timer drain the backlog one chunk at a time.
# Full ordered procedure (drop-in first, timer stopped+masked, no replay in the
# window, override removed FIRST on cleanup): runbook section 4.5
# "大 chunk 追赶", docs/runbooks/tier-node27-timeseries-storage.md.
# ----------------------------------------------------------------------------

# Absolute paths (must be owned by the nwm user, mode 0600 on the receipt).
NODE27_TIMESERIES_COMPRESSION_RECEIPT_PATH=/home/nwm/NWM/artifacts/receipts/node27_timeseries_compression.json
NODE27_TIMESERIES_COMPRESSION_LOCK_PATH=/tmp/nhms-node27-timeseries-compression.lock
