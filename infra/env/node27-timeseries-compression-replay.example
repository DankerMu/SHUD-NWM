# Copy to node27-timeseries-compression-replay.env on node-27 and chmod 0600.
# This file is an example only; never commit the real database URL or digest.
#
# DOCUMENTED SUPERUSER EXCEPTION (#1774). This lane is the ONE recurring unit
# that keeps the superuser `nhms`, and it is deliberate, not an oversight: the
# supervisor (scripts/node27_timeseries_compression_supervisor.py) runs
# `pg_dump`, two `migration_apply` steps (`psql --file <migration>`) and
# `docker exec nhms-db pg_restore`. That is migration-class DDL, which OpenSpec
# change node27-write-path-roles explicitly leaves on the migration role;
# `nhms_ingest_rw` cannot carry it. tests/test_node27_write_roles.py allow-lists
# exactly this file and the archive-rebuild drill. Do NOT copy this line into
# any other env file.
DATABASE_URL=postgresql://nhms:REPLACE_ME_PW@127.0.0.1:55432/nhms
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=nhms
PGUSER=nhms
PGPASSWORD=REPLACE_ME_PW
PGSSLMODE=disable
NODE27_COMPRESSION_EXPECTED_STALE_SHA256=REPLACE_WITH_64_HEX_DIGEST
NODE27_COMPRESSION_RUN_PLAN_SHA256=REPLACE_WITH_64_HEX_DIGEST
