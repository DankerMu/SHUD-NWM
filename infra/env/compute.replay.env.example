# Node-22 six-basin production replay EnvironmentFile template (#1164 change 2).
#
# Copy to /scratch/frd_muziyao/NWM/infra/env/compute.replay.env on node-22, set
# mode 0600, and use it ONLY with scripts/ops/node22_six_basin_replay.sh. It is a
# DEDICATED file: the production scheduler env
# (infra/env/compute.scheduler-dbfree.env) is never edited for the replay, and
# the systemd timer stays stopped for the whole operation.
#
# Start from a copy of the production scheduler env and apply the deltas below.
# Everything not listed here MUST stay byte-identical to production: the replay
# runs the full production semantics (§8 gates, strict warm start, direct-grid
# contract), it only changes admission and retention.

# --- Retention: hard requirement -------------------------------------------
# Retention is embedded in every scheduler pass and deletes by the cycle token
# in the directory name; a replay of 2026-07 cycles under an enabled retention
# would delete its own inputs and outputs. Both the shell wrapper and
# scripts/replay_driver.py refuse to start unless this is exactly `false`.
NHMS_RETENTION_ENABLED=false

# --- Replay admission triple -----------------------------------------------
# All three MUST be present and well formed: the scheduler raises
# SchedulerReplayConfigError for any partial or malformed combination, and an
# enabled mode additionally requires the exact-cycle invocation shape the driver
# uses (--cycle-time, single cycle, backfill disabled, non-continuous).
#
# MODEL_IDS is the closed set the terminal override may touch. Put ONLY the six
# dg model ids of the source being replayed here (the driver also passes
# --model-id per pass, so the two filters must agree).
NHMS_SCHEDULER_REPLAY_MODE=true
NHMS_SCHEDULER_REPLAY_MODEL_IDS=replace-with-six-dg-model-ids-comma-separated
NHMS_SCHEDULER_REPLAY_WINDOW=2026070500..2026072100

# --- Raw-manifest admission posture (two phases) ---------------------------
# 2026070500 / 070512 / 070600 / 070612 / 070700 have NO raw manifest any more
# (raw retention starts at 2026070712) while their direct-grid forcing packages
# are complete on NFS. For those cycles the replay discovery branch admits the
# cycle on forcing evidence, but the CANDIDATE-level raw-manifest gate
# (scheduler_candidates.py, fed by the journal candidate state) is a separate
# surface that the replay override deliberately does not touch: with the
# requirement left on, those candidates are blocked and nothing is submitted.
#
#   Phase 1 (cycles 2026070500..2026070700): NHMS_SCHEDULER_REQUIRE_NFS_RAW_MANIFEST=false
#   Phase 2 (cycles 2026070712..2026072100): NHMS_SCHEDULER_REQUIRE_NFS_RAW_MANIFEST=true
#
# Phase 2 MUST have it back on: the GFS 2026070712 repair pass authorizes itself
# only against a REQUIRED+ready raw manifest. See
# docs/runbooks/six-basin-replay.md for the exact execution order.
NHMS_SCHEDULER_REQUIRE_NFS_RAW_MANIFEST=false
NHMS_SCHEDULER_NFS_RAW_MANIFEST_ENABLED=true

# --- Replay tool roots -----------------------------------------------------
# NFS authority root holding the historical runs/forcing/states the replay reads
# and replaces; the scratch object store stays in OBJECT_STORE_ROOT.
NHMS_REPLAY_NFS_ROOT=/ghdc/data/nwm/object-store
# Parent directory of the pre-replay recovery archives written by
# scripts/replay_state_scope_reset.py (one six-basin-replay-<ts>/ per run).
NHMS_REPLAY_ARCHIVE_ROOT=/ghdc/data/nwm/recovery
# Scratch (Slurm-written) state index lane, needed by the reset tool alongside
# the NFS lane in NHMS_SCHEDULER_STATE_INDEX.
NHMS_SLURM_SCHEDULER_STATE_INDEX=/scratch/frd_muziyao/nhms-prod/object-store/scheduler/state-index/index-last.json

# --- Unchanged from production (do not diverge) ----------------------------
# NHMS_SCHEDULER_DB_FREE_REQUIRED=true
# NHMS_SCHEDULER_REQUIRE_DIRECT_GRID=true
# NHMS_REQUIRE_FORECAST_WARM_START=true
# NHMS_SCHEDULER_STATE_INDEX / JOURNAL_ROOT / REGISTRY_MANIFEST / ALLOWED_ROOTS
# OBJECT_STORE_ROOT / OBJECT_STORE_PREFIX / NHMS_OBJECT_STORE_COPYBACK_ROOT
# SLURM_GATEWAY_URL / NHMS_PRODUCTION_SLURM_ENABLED
