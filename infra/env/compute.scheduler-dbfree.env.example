# Node-22 DB-free scheduler EnvironmentFile template.
#
# Copy to /scratch/frd_muziyao/NWM/infra/env/compute.scheduler-dbfree.env on
# node-22, set mode 0600, and reference from the systemd user unit
# nhms-compute-scheduler.service via EnvironmentFile=.
#
# The scheduler daemon here is the production runner
#   `nhms-pipeline plan-production --continuous --submit`
# which drives services/orchestrator/scheduler.py run_continuous with a strict
# DB-free contract: no DATABASE_URL / PIPELINE_DATABASE_URL is inherited and all
# lock/state/journal/registry/readiness surfaces are file-backed on the shared
# NFS object-store or local scratch. See receipts/
# 2026-06-28-node22-dbfree-scheduler-live-proof.md (line 15 for the on-node
# path, line 51 for the systemd EnvironmentFile= binding) as the source-of-truth
# reference for this template. Design rationale: OpenSpec change
# `instrument-node22-scheduler-pass-timing` decision D8.

# --- DB-free contract gate --------------------------------------------------
# When true, the scheduler refuses to start if DATABASE_URL is set or if any
# backend other than `file` is requested; this fails-closed against silent
# regressions to a DB-coupled path.
NHMS_SCHEDULER_DB_FREE_REQUIRED=true

# --- File-backed lock ------------------------------------------------------
# Root directory holding per-pass advisory lock files. Should live on a
# filesystem shared with the systemd unit user. The lease uses atomic CAS;
# journal writes separately require a proven cross-process flock guard.
NHMS_SCHEDULER_LOCK_ROOT=/scratch/frd_muziyao/nhms-prod/workspace/scheduler/locks
NHMS_SCHEDULER_LOCK_BACKEND=file
NHMS_SCHEDULER_LEASE_GUARD_MODE=atomic

# --- File-backed state / registry / journal --------------------------------
# All scheduler runtime surfaces are file-backed. The manifests/indexes point
# at the shared NFS object-store so node-27 (or any lab peer) can observe the
# scheduler's declared state without a DB round-trip.
NHMS_SCHEDULER_STATE_BACKEND=file
NHMS_SCHEDULER_REGISTRY_BACKEND=file
NHMS_SCHEDULER_REGISTRY_MANIFEST=/ghdc/data/nwm/object-store/scheduler/registry/manifest-last.json
NHMS_SCHEDULER_CANONICAL_READINESS_BACKEND=file
NHMS_SCHEDULER_CANONICAL_READINESS_INDEX=/ghdc/data/nwm/object-store/scheduler/canonical-readiness/index-last.json
NHMS_SCHEDULER_JOURNAL_BACKEND=file
NHMS_SCHEDULER_JOURNAL_ROOT=/scratch/frd_muziyao/nhms-prod/workspace/scheduler/journal
NHMS_SCHEDULER_JOURNAL_LOCK_GUARD_MODE=flock
NHMS_SCHEDULER_STATE_INDEX_BACKEND=file
NHMS_SCHEDULER_STATE_INDEX=/ghdc/data/nwm/object-store/scheduler/state-index/index-last.json

# --- Trusted node-27 raw-manifest authority -------------------------------
# node-22 sees node-27's /home/ghdc/nwm/object-store through this shared NFS
# mount. The scheduler re-reads manifests and referenced raw files from this
# private trusted path; public evidence remains redacted. The copyback root is
# the configured shared-NFS authority and the raw-manifest root must both
# resolve to the fixed node-22 production topology identity enforced by code.
# Equality between these two variables is not authority. Keep both distinct
# from staging OBJECT_STORE_ROOT.
NHMS_OBJECT_STORE_COPYBACK_ROOT=/ghdc/data/nwm/object-store
NHMS_SCHEDULER_REQUIRE_NFS_RAW_MANIFEST=true
NHMS_SCHEDULER_NFS_RAW_MANIFEST_ROOT=/ghdc/data/nwm/object-store
NHMS_SCHEDULER_NFS_RAW_MANIFEST_PREFIX=s3://nhms

# --- Evidence + runtime + tmp roots ----------------------------------------
# Per-pass evidence artefacts land under EVIDENCE_ROOT (see the retention timer
# below for bounded growth). RUNTIME_ROOT and TEMP_ROOT are scheduler-owned
# scratch surfaces; the retention script does NOT touch them.
NHMS_SCHEDULER_EVIDENCE_ROOT=/scratch/frd_muziyao/nhms-prod/workspace/scheduler/evidence
NHMS_SCHEDULER_RUNTIME_ROOT=/scratch/frd_muziyao/nhms-prod/runtime
NHMS_SCHEDULER_TEMP_ROOT=/scratch/frd_muziyao/nhms-prod/tmp

# --- Filesystem allow-list -------------------------------------------------
# Colon-separated set of roots the scheduler is permitted to read/write.
# Any path outside this list is rejected by preflight before any Slurm work.
NHMS_SCHEDULER_ALLOWED_ROOTS=/scratch/frd_muziyao/nhms-prod/workspace:/scratch/frd_muziyao/nhms-prod/object-store:/scratch/frd_muziyao/nhms-prod/runtime:/scratch/frd_muziyao/nhms-prod/tmp:/ghdc/data/nwm/object-store:/ghdc/data/nwm/published

# --- Pipeline runtime roots (issue #1392) -----------------------------------
# Consumed directly by the runbook provision/publisher shell
# (docs/runbooks/current-production-ops.md) and by `nhms-pipeline
# plan-production` preflight: WORKSPACE_ROOT is required by the CLI when
# --workspace-root is omitted, and OBJECT_STORE_ROOT is a required runtime
# root under NHMS_SCHEDULER_DB_FREE_REQUIRED=true. Values verified against the
# node-22 live env (read-only, 2026-08-17); the two local roots below must stay
# inside NHMS_SCHEDULER_ALLOWED_ROOTS.
WORKSPACE_ROOT=/scratch/frd_muziyao/nhms-prod/workspace
OBJECT_STORE_ROOT=/scratch/frd_muziyao/nhms-prod/object-store
OBJECT_STORE_PREFIX=s3://nhms
NHMS_BASINS_ROOT=/volume/nwm/Basins

# --- Business scope --------------------------------------------------------
# Comma-separated forecast sources the scheduler considers each pass.
NHMS_SCHEDULER_SOURCES=gfs,IFS

# --- Slurm gateway service bearer (#1684) -----------------------------------
# The DB-free scheduler submits/cancels through the node-22 standalone Slurm
# gateway, whose mutations require the route-scoped service bearer. The value
# MUST NOT be committed here or in any tracked file: keep it in an untracked
# owner-mode-0600 env source that both this file's EnvironmentFile and the
# gateway unit load (see infra/env/README.md and
# docs/runbooks/current-production-ops.md §3.2). The client reads it at request
# time and attaches it only to POST/DELETE mutation calls; health/read requests
# never carry it. Without a usable token the scheduler preflight fails closed.
# SLURM_GATEWAY_SERVICE_TOKEN=<loaded from 0600 env source>

# Bound source/cycle cohort submission and polling control threads only. The
# current 18-model registry becomes one 18-task Slurm array per source/cycle;
# the global array bound below plus resource-profile max_concurrent own compute.
NHMS_SCHEDULER_CONCURRENT_SUBMIT_BOUND=4
# Strict aggregate ceiling across Slurm arrays submitted by one scheduler pass.
NHMS_SCHEDULER_SLURM_ARRAY_CONCURRENCY_BOUND=32
NHMS_SCHEDULER_RECONCILE_ABSENCE_SECONDS=300
# Consecutive identity-mismatch reconcile passes tolerated before a
# reserved-unbound forecast master is released to `reservation_lost`
# (decision `identity_mismatch_released`). `<= 0` disables the exit and keeps
# the historical behaviour where such a row wedges the cycle with
# PIPELINE_ALREADY_ACTIVE forever; when disabled the durable
# `identity_blocked_streak` counter also freezes at its current value (0 only
# for rows that never counted; a row that reached 2 under an enabled exit keeps
# reporting 2), so no-progress must be read from the repeated
# `identity_mismatch_blocked` evidence rows instead.
NHMS_SCHEDULER_IDENTITY_BLOCKED_STREAK_LIMIT=3
# Consecutive fully-observed passes reporting the same (subject, reason) before
# the observe-only no-progress circuit marks it open: a `no_progress_circuit`
# block in the pass evidence plus one aggregated
# `SCHEDULER_NO_PROGRESS_CIRCUIT_OPEN` warning per pass. It never changes a
# scheduling decision. `<= 0` disables it completely — no tracker state file
# under the evidence root, no evidence key, no log line. Early-exit, pre-lock,
# lock-contended and resource-limit-aborted passes neither count nor clear, so
# the count spans more wall-clock than the same number of timer ticks.
NHMS_SCHEDULER_NO_PROGRESS_CIRCUIT_PASSES=3
NHMS_SCHEDULER_RECONCILE_SLURM_USER=frd_muziyao
NHMS_SCHEDULER_RECONCILE_SLURM_ACCOUNT=replace-with-node22-slurm-account
NHMS_SCHEDULER_REQUIRE_DIRECT_GRID=true

# Comma-separated UTC hours (0-23) that are eligible business cycle boundaries.
# The scheduler hard-gates on this list; adapter cycle-hour env only narrows
# provider probes.
NHMS_SCHEDULER_ALLOWED_CYCLE_HOURS_UTC=0,12

# Leave NHMS_SCHEDULER_MODEL_IDS empty in production so the DB-free file
# registry drives every active Basins model published from NHMS_BASINS_ROOT.
# Narrow this only for a targeted rollback / drill (comma-separated model ids).
# NHMS_SCHEDULER_MODEL_IDS=

# --- Pass timing instrumentation (change: instrument-node22-scheduler-pass-timing) ---
# Level controls per-pass timing verbosity:
#   pass      = pass-boundary spans only
#   stage     = pass + per-stage spans (default; always-on health baseline)
#   candidate = pass + stage + per-basin sub-phase spans (opt-in, diagnostic)
# Unknown values fail the pass closed with reason
# `scheduler_timing_level_unrecognised` while still emitting `timing.pass`.
NHMS_SCHEDULER_TIMING_LEVEL=stage    # pass|stage|candidate (default: stage)

# --- Journal-cycle cold retention (archive-file-journal-cycle-retention) -----
# This independent node-22 timer owns only journal/latest/pipeline-events hot
# cycle members. It starts disabled and dry-run; a later operator change must
# first review receipts and explicitly flip BOTH safety switches.
NHMS_SCHEDULER_JOURNAL_RETENTION_ENABLED=false
NHMS_SCHEDULER_JOURNAL_RETENTION_DRY_RUN=true
NHMS_SCHEDULER_JOURNAL_RETENTION_DAYS=90
NHMS_SCHEDULER_JOURNAL_ARCHIVE_ROOT=/scratch/frd_muziyao/nhms-prod/workspace/scheduler/journal-archive
# Its scheduler window proof is explicit rather than relying on code defaults.
NHMS_SCHEDULER_LOOKBACK_HOURS=96
NHMS_SCHEDULER_CYCLE_LAG_HOURS=16

# --- Evidence retention (change: instrument-node22-scheduler-pass-timing) --
# Delete pass evidence older than N days first, then evict oldest until total
# size fits under the MB cap. Retention receipts under EVIDENCE_ROOT/retention/
# have their own longer window (see the retention script for defaults).
NHMS_SCHEDULER_EVIDENCE_RETENTION_DAYS=90  # delete pass evidence older than N days
NHMS_SCHEDULER_EVIDENCE_MAX_MB=512    # evict oldest until <= N MB after age pass

# --- Forecast-data retention across the additional run roots (issue #1318) ---
# The three roots configured in this file are distinct paths, and retention
# historically swept only OBJECT_STORE_ROOT (line 82). WORKSPACE_ROOT/runs and
# NHMS_OBJECT_STORE_COPYBACK_ROOT/runs therefore accumulated without bound --
# the copyback root sits on the NFS export that shares node-27's /home volume
# with the PostgreSQL data directory.
# With the switch on, both roots are swept runs/ ONLY. Their raw/, canonical/
# and forcing/ trees are never selected: the copyback forcing/ tree is the
# node-27 display API's live disk-only serving surface.
# Default off. Two-step rollout: turn it on with NHMS_RETENTION_DRY_RUN=true
# first, review the planned list (each entry names its root), then enforce.
# Rollback is turning this back to false.
NHMS_RETENTION_EXTRA_ROOTS_ENABLED=false
# Independent window for the additional roots; NHMS_RETENTION_DAYS still
# governs OBJECT_STORE_ROOT. `nhms-pipeline cleanup --retention-days N`
# overrides the object-store window only, never this one.
NHMS_RETENTION_EXTRA_ROOTS_DAYS=30

# --- Registry cutover declaration (change: node22-db-free-scheduler-state §8) ---
# Consumed by the scheduler's `_load_cutover_declaration` at planning time
# (D8.1: read once per pass, cached per ProductionScheduler lifetime).
# When unset every §8 candidate is treated as `no_declaration` — declared-
# cutover candidates will block with `block_declaration_missing` and
# existing-generation warm-continue remains unaffected.  Publisher-side
# refresh must land the same path (see
# infra/env/compute.scheduler-provider-refresh.env.example).
# NHMS_REGISTRY_CUTOVER_DECLARATION_PATH=/scratch/frd_muziyao/nhms-prod/object-store/scheduler/cutover/declaration-last.json
