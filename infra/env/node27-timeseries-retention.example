# Node-27 timeseries retention runner (issue #855 / OpenSpec: tier-node27-timeseries-storage).
#
# Retention is DB-side only. Since #1370 it has no archive-side coupling at
# all: the archive lane is permanently retired (ADR 0002 Revision 2026-08-11),
# so there are no gate receipts to point at and no archive env file to keep in
# sync. Do not sync this env against node27-resource-governance.env.
#
# Copy to node27-timeseries-retention.env and chmod 0600.

NODE27_TIMESERIES_RETENTION_REPO=/home/nwm/NWM

# Node-27 primary Postgres (writer role — retention performs drop_chunks DDL).
# #1714: the retention runner ships a default application_name `nhms-ts-retention` (libpq
# fallback_application_name) so pg_stat_activity can attribute it. To override,
# append ?application_name=<name> to the DSN below; an explicit value always wins.
DATABASE_URL=postgresql://REPLACE_ME_WRITER:REPLACE_ME_PW@127.0.0.1:55432/nhms
# The same connection is queried read-only first for the latest displayable
# forecast cycle; the 14-day window is relative to that business-time watermark.

# Drop-window size in days. Default 14 = spec §Window and mechanism.
# Chunks whose entire range is older than the watermark-relative window are eligible.
NODE27_TIMESERIES_RETENTION_WINDOW_DAYS=14

# Maximum number of chunks dropped per timer tick. Default 5 (matches
# compression sibling per-tick bound).
NODE27_TIMESERIES_RETENTION_PER_TICK_BOUND=5

# Drop-phase lock budget in milliseconds (issue #1664). Applied as
# `SET lock_timeout` in the same session as `drop_chunks`, so a drop blocked
# behind a concurrent writer refuses as SQLSTATE 55P03 (reported as
# `lock-contention(55P03)` in refusal_reason) with a BOUNDED wait, instead of
# burning the whole 300 s statement budget and returning an unattributable
# 57014. Leave it unset to take the pinned default 240000.
#
# HARD BOUND: the value must be an integer strictly greater than 0 and
# strictly less than the drop-phase statement_timeout (`_DROP_TIMEOUT_MS`
# = 300000 in scripts/node27_timeseries_retention.py). 0, a negative number,
# 300000, anything above it, or a non-integer aborts the tick with
# RETENTION_CONFIG_INVALID, exit 2, no receipt and no DB connection. An empty
# assignment is treated as unset (default applies), matching the WINDOW_DAYS /
# PER_TICK_BOUND convention.
#
# Why 240000 and NOT the 2-5 s the issue suggested (recorded deviation,
# OpenSpec design D3): a successful 08-19 tick spent ~182 s of wall clock that
# its 0.638 GB of delete work does not explain (08-17 / 08-20 freed ~11 GB in
# 23 s / 1 s). That number is the wrapper's `elapsed_sec`, which brackets the
# WHOLE run (watermark + enumeration + per-chunk measurement, none of them
# lock-bounded), so it CANNOT be read as a measured lock wait. The decision
# rests on the cost asymmetry and the attribution gap instead, and the
# per-chunk drop timing (#1664, runbook 8.6 item 6) exists to replace this
# inference with a measurement. The cost is
# asymmetric (this is the only lane with delete authority; nothing waits on
# it — TimeoutStartSec=0, no `timeout(1)`, next tick 24 h later), and the
# 60 s gap between 240 s and 300 s keeps 55P03 (lock bound) and 57014
# (statement bound) unambiguous. Lowering it does NOT make failures rarer —
# see runbook §8.2 on what this bound does and does not buy.
#NODE27_TIMESERIES_RETENTION_LOCK_TIMEOUT_MS=240000

# Archive-gate mode (issue #1369, completed by #1370). REQUIRED, and the only
# accepted value is "disabled". The archive lane is permanently retired by
# docs/adr/0002-node27-timeseries-hot-cold-tiering.md Revision 2026-08-11
# (after the /dev/md0 double-disk failure), so the "enabled" mode retired with
# it. The value is stripped and lowercased and MUST then be exactly
# "disabled"; a missing line, "enabled", an empty assignment, "disable",
# "true", "1" — anything else aborts the tick with RETENTION_CONFIG_INVALID,
# exit 2, and NO receipt. There is deliberately no truthiness fallback and no
# default: setting this line is the operator's explicit acknowledgement.
#
# !!! DANGER — what you are acknowledging !!!
#   * chunks are dropped with NO ARCHIVE BACKSTOP — the deletion is
#     IRREVERSIBLE, there is no restore lane, and no salvage object exists;
#   * boundary-partial chunks are NOT deferred (they are drop candidates —
#     "partially covered" is meaningless without archive data);
#   * the enforced receipt's salvage_backed_windows is always [];
#   * every receipt records archive_gate.mode plus the ADR citation, so the
#     deletion authority is auditable rather than implicit.
# Rolling back means "stop deleting more": set
# NODE27_TIMESERIES_RETENTION_ENFORCE=0 below and/or disable the timer
# (`systemctl --user disable --now nhms-node27-timeseries-retention.timer`).
# Deleting THIS line is not a rollback — it makes every tick fail with
# RETENTION_CONFIG_INVALID. Already-dropped chunks cannot be recovered either
# way.
# CLI --archive-gate overrides this variable; it still accepts "enabled" as a
# spelling so that requesting it produces this diagnostic rather than a bare
# argparse usage error.
NODE27_TIMESERIES_RETENTION_ARCHIVE_GATE=disabled

# Absolute path — retention runner's own receipt (mode 0600, atomic).
# LEAVE THIS UNSET under timer operation (keep the line commented). NOTE for
# already-deployed env files: this example shipped the assignment UNCOMMENTED
# until 2026-08-14, so a deployed copy made before then HAS it set — comment it
# out there and verify with
#   grep -n '^NODE27_TIMESERIES_RETENTION_RECEIPT_PATH=' <deployed env file>
# returning zero matches (runbook §8.1 step 2). When it is
# unset the wrapper substitutes a per-tick timestamped filename
# (retention-<UTC>.json under the log root), so every tick keeps its own
# receipt. Setting a FIXED path makes each daily tick atomically OVERWRITE the
# previous receipt, destroying the per-tick audit trail of irreversible
# deletions — the only record of which chunks were dropped when.
# Consequence for manual runs: `python scripts/node27_timeseries_retention.py`
# invoked directly (not via the wrapper) has no receipt path at all with this
# unset, and refuses with RETENTION_CONFIG_INVALID, exit 2, no receipt. Pass an
# explicit timestamped --receipt-path instead. See runbook §8.1 step 2 / §8.4.
#NODE27_TIMESERIES_RETENTION_RECEIPT_PATH=/home/nwm/node27-timeseries-retention-logs/retention-manual.json

# H10 lock path — MUST match docs/runbooks/tier-node27-timeseries-storage.md
# §8.1 install steps + §8.6 recovery step and scripts/node27_timeseries_retention.py
# _default_lock_path() (byte-identical). Override only if the deployment
# needs a non-default absolute path.
NODE27_TIMESERIES_RETENTION_LOCK_PATH=/tmp/nhms-node27-timeseries-retention.lock

# Enforce mode toggle. Absent / empty / "0" / "false" / "no" → dry-run
# (default, safe). Any other non-empty value → enforce (WILL drop chunks
# older than the drop window). FIRST RUN MUST BE DRY-RUN — inspect the
# receipt's candidate_chunks + deferred_remainder before flipping to
# enforce. See runbook §8.4.
#
# !!! The --dry-run CLI flag does NOT override this variable !!!
# Dry-run vs enforce is decided solely by --enforce / this variable; --dry-run
# is never read. Once this line is uncommented (the steady state after the
# timer is enabled), sourcing this file and running with --dry-run still
# ENFORCES and irreversibly drops up to PER_TICK_BOUND chunks. Any manual
# dry-run after that point on the DIRECT-python lane
# (uv run python scripts/node27_timeseries_retention.py) MUST prefix the
# command with NODE27_TIMESERIES_RETENTION_ENFORCE=0 (inline, after the
# source). The WRAPPER lane (scripts/node27_timeseries_retention_once.sh)
# CANNOT be made safe that way: the wrapper re-sources THIS file with
# `set -a` after the prefix has applied, so the file's value wins and the
# tick enforces anyway. The only way to dry-run through the wrapper is to
# set NODE27_TIMESERIES_RETENTION_ENFORCE=0 in this file itself.
#NODE27_TIMESERIES_RETENTION_ENFORCE=1
