# Node-27 published-frontier stall alerting (issue #1368 / OpenSpec:
# node27-frontier-stall-alert).
#
# Copy to node27-frontier-alert.env and chmod 0600 — the wrapper
# (scripts/node27_frontier_stall_alert_once.sh) refuses a symlinked or
# non-0600 env file on EVERY path (systemd or manual: the permission contract
# does not depend on who parses the file), and refuses a missing file on the
# manual path.
#
# This lane only READS the database and only sends mail through a
# sendmail-compatible binary; it never writes to Postgres. The alerter process
# itself holds no SMTP credentials — the NHMS_SMTP_* values below are read by
# the sendmail shim it execs (see NHMS_FRONTIER_SENDMAIL).
#
# SINGLE READER: under systemd this file is read once by
# `EnvironmentFile=` in nhms-node27-frontier-alert.service, which also sets
# `Environment=NODE27_FRONTIER_ALERT_ENV_INJECTED=1`. The wrapper sources the
# file only when that lane-scoped sentinel is absent (i.e. manual debugging
# from a shell), so no value is ever parsed by both grammars in one run.
# Values here must nevertheless mean the same thing to BOTH parsers: quote any
# value containing spaces (systemd strips the surrounding quotes, so does the
# shell). WARNING: a password containing  $ ` " \  is NOT dual-grammar safe —
# bash expands/eats those inside double quotes while systemd does not. If the
# read-only role's password needs such characters, use single quotes and verify
# both paths, or (preferred) pick a password from [A-Za-z0-9._~-].

NODE27_FRONTIER_ALERT_REPO=/home/nwm/NWM

# Node-27 primary Postgres — use the READ-ONLY role DSN (nhms_display_ro).
# The alerter runs one read-only aggregate over hydro.hydro_run; a writer role
# here would hand a monitoring lane needless mutation rights (least privilege).
# The runner supplies its own bounded connect_timeout (10 s) and
# statement_timeout (30 s); do NOT append connect_timeout=0 or any unbounded
# libpq keyword here — an unbounded connect would let the watchdog hang the
# same way the thing it watches did.
DATABASE_URL=postgresql://nhms_display_ro:REPLACE_ME_PW@127.0.0.1:55432/nhms

# Alert recipient. REQUIRED, no default: an unset value fails the run closed
# (structured config error, exit 2) rather than silently mailing nobody.
# A CR/LF anywhere in this value is rejected at config time (header injection).
#
# WARNING — keep this to a SINGLE recipient. The shim submits one envelope for
# all addresses: if the provider refuses ANY of them, the whole send is a
# failure (exit 69) even though the others were accepted, so the alerter retries
# and the accepted recipient gets a duplicate every 30 min for as long as the
# stall lasts. One recipient is the supported shape; fan out at the mailbox
# (an alias/forwarding rule), not here.
NHMS_ALERT_EMAIL_TO=mumzy1995@163.com

# From header. Ships ACTIVE on purpose — the derived default
# "NHMS Frontier Alert <nwm@$(hostname)>" is not the authenticated account, and
# the shim now refuses that at config time (exit 64) instead of collecting a
# 550 per tick. The ADDRESS part must equal NHMS_SMTP_USER below (163 rejects a
# From that differs from the account that authenticated); a display name in
# front of it is fine and is what an operator sees in the inbox.
# Quoted because the value contains spaces: systemd strips the surrounding
# double quotes and so does the shell, so both readers see the same string.
NHMS_ALERT_EMAIL_FROM="NHMS Frontier Alert <alerts@example.com>"

# Stall window in hours. Default 4. Rationale: a full measured pass is
# 2h16m-3h01m plus 15-30 min ingest lag, so the realistic upper bound of a
# healthy production cycle is ~3h30m; 4 h leaves margin without hiding a real
# outage for long. Progress is directional (new source, or a strict increase
# of frontier / distinct-cycle count / latest arrival) and is NEVER compared
# against wall-clock lag — while backfilling, the frontier is legitimately
# days behind.
# Threshold rule: no-progress alarm must exceed the production cycle cadence,
# or the steady state itself alarms daily. 4 fits backfill (multiple cycles/day,
# incident-era floor); steady state at ONE cycle/day needs ~2x cadence — node-27
# runs 48 (operator ruling 2026-08-14, recorded in runbook section 10.3).
NHMS_FRONTIER_STALL_HOURS=4

# Resend window in hours while a stall persists. Default 6 (one stall = one
# mail, then at most one mail per 6 h until progress resumes).
NHMS_FRONTIER_RESEND_HOURS=6

# Absolute path — persisted high-water baseline + alert state (mode 0600,
# atomic tmp+rename). The single-instance lockfile is derived from it
# (<state path>.lock) and the whole directory belongs to this lane.
# Deleting this file is indistinguishable from a first install: the next tick
# bootstraps a fresh baseline silently (blind window <= NHMS_FRONTIER_STALL_HOURS).
NHMS_FRONTIER_STATE_PATH=/home/nwm/node27-frontier-alert-logs/frontier-alert-state.json

# Absolute path — latest-tick observation receipt (atomically overwritten).
# The append-only alert event log is derived beside it as
# <receipt dir>/frontier-alert-events.jsonl.
NHMS_FRONTIER_RECEIPT_PATH=/home/nwm/node27-frontier-alert-logs/frontier-alert-receipt.json

# Absolute path to the sendmail-compatible binary (invoked as `<path> -t -i`,
# message on stdin, exit 0 == sent).
#
# WARNING — the /usr/sbin/sendmail default does NOT deliver on node-27: the
# local postfix is null-routed (`default_transport = error`, loopback-only).
# It accepts the message with exit 0 and then asynchronously bounces it
# (observed live 2026-08-13: `dsn=5.0.0 status=bounced`), so the lane records
# a successful send for mail that never left the box.
#
# Use the authenticated-SMTP shim instead: it submits over SMTPS directly to
# the provider and only exits 0 on a synchronous 250 (evidence line
# `SMTP-ACCEPTED host=... code=250 recipients=<n>` on stderr).
NHMS_FRONTIER_SENDMAIL=/home/nwm/NWM/scripts/node27_frontier_smtp_sendmail.py

# --- SMTP shim channel (read ONLY by scripts/node27_frontier_smtp_sendmail.py;
# the alerter itself never touches these). Credentials are environment-only,
# never argv. NHMS_SMTP_PASS is passed to login() and to nothing else — it is
# never interpolated into any log or error line.
NHMS_SMTP_HOST=smtp.163.com
NHMS_SMTP_PORT=465
NHMS_SMTP_USER=alerts@example.com
# 163 SMTP authorization code (NOT the mailbox login password) — deposit
# manually on node-27, never commit. Dual-grammar warning above applies: a
# code containing  $ ` " \  is not safe for both readers; 163 codes are
# alphanumeric, so leave it unquoted.
NHMS_SMTP_PASS=REPLACE_ME_163_AUTH_CODE
# Reminder: NHMS_ALERT_EMAIL_FROM above must carry this same address (address
# part only; a display name in front of it is fine) — 163 rejects a From header
# that differs from the authenticated account, the shim leaves the header
# exactly as the alerter built it, and it refuses a mismatch at config time
# (exit 64, nothing connected) rather than failing every send.

# Consecutive failed observation ticks before an observability-unavailable
# alert is raised. Default 2 (= 1 h at the 30 min timer cadence). Query
# failures never reset the stall clock.
NHMS_FRONTIER_QUERY_FAIL_TICKS=2
