[Unit]
Description=Run NHMS node-27 coverage freshness alert daily

[Timer]
# Daily (design D4). The threshold is 4 days against a 12-day display window, so
# ~8 days of margin remain after the first trip and a daily tick costs at most
# one of them. The `OnFailure=` handler is deliberately dumb and has no dedup,
# so cadence IS the mail-volume bound: a standing gap mails once a day, where
# the frontier lane's 30-minute cadence would emit 48 identical mails for a
# days-scale condition. Silence comes from clearing the condition.
OnCalendar=*-*-* 06:00:00
Persistent=true
Unit=nhms-node27-coverage-freshness-alert.service

[Install]
WantedBy=timers.target
