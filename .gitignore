# Upstream model repos (local reference only)
SHUD/
rSHUD/
AutoSHUD/

# Agent local config and installed/generated skill copies. These are per-machine
# installs kept in sync by the skill manager, not project source: tracking them
# produced permanent working-tree drift (edits plus relocations between
# .agents/skills/ and .agents/skills-manual/) on every install. Untracked as of
# this commit; recover history from git log if a copy is ever needed.
.claude/
.agents/skills/
.agents/skills-manual/
.omp/

# Design artifacts (tracked separately)
设计图/
.review-gate.json

# Local subagent worktrees (git-worktree checkouts under the repo root)
.worktrees/
