# Node-27 per-issue live-evidence directories (mode-0600 receipts; never synced).
# The replay supervisor's checkout-lineage gate runs
# `git status --porcelain=v1 --untracked-files=normal` and fails closed on ANY
# untracked entry, so these MUST be ignored for the replay to be executable.
.nhms-issue*-live/
# River-click runbook private dirs (C4-river-click / tier §4.9): per-run roots
# `.nhms-issue1895-riverclick-XXXXXX` and pin discovery `.nhms-issue1970-riverclick-pins-XXXXXX`.
.nhms-issue*-riverclick-*/
# Previous frontend bundle kept for rollback by the node-27 D5 dist swap.
apps/frontend/dist.old*/
apps/frontend/dist.new/

# Subagent-workflow session-local review artifacts (persistent record lives in docs/review-loop-log.jsonl)
.workplans/
/artifacts/
!services/artifacts/
!services/artifacts/*.py
.pgdata/
.pglogs/
.pgsocket/
.conda-pkgs/
.conda-postgres-runtime/
data/
# Local/generated Codex workflow outputs. Existing tracked .codex/reviews/**
# fixtures remain historical project evidence.
.codex/
# Local PR-review scratch evidence (per-PR review notes, not tracked project assets).
.review/
apps/frontend/artifacts/
.tmp/

